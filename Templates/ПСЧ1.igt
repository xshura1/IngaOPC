<Header FileDescription="IngaOPC Template File" Version="0101" Checked="-1" Script="function ExtractDWord(DriverData:TIGDriverData; var Value:dword):boolean;
var s:string;
    i:integer;
begin
 result:=false;
 if DriverData.result=0 then
  if DriverData.count=8 then
   begin
     s:='';
     for i:=0 to DriverData.count-1 do
      s:=s+chr(DriverData[i]);
     try
       Value:=strtoint(s);
       result:=true;
     except
     end;  
   end;
  

end;


function ExtractDateTime(DriverData:TIGDriverData; var Value:TDateTime):boolean;
var ss,s,m,h,d,mo,y:word;
begin
 result:=false;
 if DriverData.result=0 then
  begin
   if DriverData.count=13 then
   try
    h:=strtoint(chr(DriverData[1])+chr(DriverData[2]));
    m:=strtoint(chr(DriverData[3])+chr(DriverData[4]));
    s:=strtoint(chr(DriverData[5])+chr(DriverData[6]));
    
    d:=strtoint(chr(DriverData[7])+chr(DriverData[8]));
    mo:=strtoint(chr(DriverData[9])+chr(DriverData[10]));
    y:=strtoint(chr(DriverData[11])+chr(DriverData[12]))+2000;
    Value:=EncodeDate(y,mo,d);
    Value:=Value+EncodeTime(h,m,s,ss);
    result:=true;
   except
    
   end; 
  end;
 

end;

procedure SetEnOfMonth(M:word);
var EnM,EnM1:integer;
begin
 EnM:=-1; EnM1:=-1;
 if (m&lt;1) or (m&gt;12) then
  begin
   [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   exit;
  end;

 EnM:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m-1];
 if m=12 then
   EnM1:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[1]
  else
   EnM1:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m];
 if (EnM1&gt;-1) and (EnM&gt;-1) then
  begin  
   if EnM1-EnM&lt;0 then
    [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE
   else
    [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewValue:=EnM1-EnM;
  end
 else
  [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;    
     
end;


procedure SetOtvResult(Res:dword);
begin
 if Res=0 then
  begin
   [&quot;ShortSost&quot;].NewValue:=1;
  end
 else
  [&quot;ShortSost&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
end;
 


procedure &lt;Тест прибора/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
begin
 [&quot;Command_T&quot;].run;  
end;

procedure &lt;Тест прибора/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_T&quot;].run;
end;

procedure &lt;Команда Тест прибора/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   if DriverData.count&gt;0 then
    if chr(DriverData[0])='Y' then
     [&quot;Commands\Дополнительно\Тест прибора&quot;].NewValue:=true
    else
     [&quot;Commands\Дополнительно\Тест прибора&quot;].NewValue:=false; 
  end
 else
  [&quot;Commands\Дополнительно\Тест прибора&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
 
end;

procedure &lt;Потр. энергия по полупиковому тарифу/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_E&quot;].Priority:=2000;
 [&quot;Command_E&quot;].run;
end;

procedure &lt;Command_E/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d:dword;
begin
 SetOtvResult(DriverData.result);
 if ExtractDWord(DriverData,d) then
  begin
   [&quot;Commands\Потребленная энергия по тарифам\Полупиковой тариф&quot;].NewValue:=d;
   [&quot;Текущее потребление&quot;].NewValue:=(d*[&quot;Setup\Коэффициенты\Kt&quot;].oldvalue*[&quot;Setup\Коэффициенты\Ku&quot;].OldValue)/1000;



  end
 else
  begin
   [&quot;Commands\Потребленная энергия по тарифам\Полупиковой тариф&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;Текущее потребление&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
  end; 
 
end;

