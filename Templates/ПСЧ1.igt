procedure &lt;Дата и время на счетчике/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var ss,s,m,h,d,mo,y:word;
    str:string;
begin
 try
 DecodeDate([&quot;Commands\Дополнительно\Дата и время на счетчике&quot;].vqt.value,y,mo,d);
 DecodeTime([&quot;Commands\Дополнительно\Дата и время на счетчике&quot;].vqt.value,h,m,s,ss);
 
 str:=inttostr(2);
 [&quot;Command_DataCurrWrite&quot;][0]:=ord(str[1]);
 
 if d&lt;=9 then
  str:='0'+inttostr(d)
 else
  str:=inttostr(d); 
 
 [&quot;Command_DataCurrWrite&quot;][1]:=ord(str[1]);
 [&quot;Command_DataCurrWrite&quot;][2]:=ord(str[2]);
 
 if mo&lt;=9 then
  str:='0'+inttostr(mo)
 else
  str:=inttostr(mo); 
 
 [&quot;Command_DataCurrWrite&quot;][3]:=ord(str[1]);
 [&quot;Command_DataCurrWrite&quot;][4]:=ord(str[2]);
 
 y:=y-2000;
 if y&lt;=9 then
  str:='0'+inttostr(y)
 else
  str:=inttostr(y); 
 
 [&quot;Command_DataCurrWrite&quot;][5]:=ord(str[1]);
 [&quot;Command_DataCurrWrite&quot;][6]:=ord(str[2]);
 
 [&quot;Command_DataCurrWrite&quot;].run;
 
 if h&lt;=9 then
  str:='0'+inttostr(h)
 else
  str:=inttostr(h); 
 
 [&quot;Command_TimeCurrWrite&quot;][0]:=ord(str[1]);
 [&quot;Command_TimeCurrWrite&quot;][1]:=ord(str[2]);
 
 if m&lt;=9 then
  str:='0'+inttostr(m)
 else
  str:=inttostr(m); 
 
 [&quot;Command_TimeCurrWrite&quot;][2]:=ord(str[1]);
 [&quot;Command_TimeCurrWrite&quot;][3]:=ord(str[2]);
 
 
 if s&lt;=9 then
  str:='0'+inttostr(s)
 else
  str:=inttostr(s); 
 
 [&quot;Command_TimeCurrWrite&quot;][4]:=ord(str[1]);
 [&quot;Command_TimeCurrWrite&quot;][5]:=ord(str[2]);
 
 [&quot;Command_TimeCurrWrite&quot;].run;
 
 except
 end;

end;

procedure &lt;Энергия по полупиковому тарифу за Январь/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
var i,j:integer;
    s:string;
begin
 for i:=0 to Tags.count-1 do
  if Tags[i].PropExists(5000) then
   if Tags[i].OldQuality&lt;&gt;OPC_QUALITY_GOOD then
   begin
     j:=Tags[i].Prop[5000].Value;
     if j&lt;=9 then
      s:='0'+inttostr(j)
     else
      s:=inttostr(j);
     [&quot;Command_[&quot;][0]:=ord(s[1]);
     [&quot;Command_[&quot;][1]:=ord(s[2]);
     [&quot;Command_[&quot;].run;
   end;
end;

procedure &lt;Command_[/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var j:integer;
    s:string;
    En:dword;
    y,m,m1,d:word;
    m1Run:boolean;
begin
 SetOtvResult(DriverData.result);
 if Command.count=0 then exit;
 s:=chr(Command[0])+chr(Command[1]);
 j:=strtoint(s);
 if (j&gt;=1) and (j&lt;=12) then
  if ExtractDWord(DriverData,En) then
    [&quot;Commands\Энергия по месяцам\Массив энергии&quot;].NewValueAsArray[j-1]:=En
  else
    [&quot;Commands\Энергия по месяцам\Массив энергии&quot;].NewValueAsArray[j-1]:=-1;
 
 try
  DecodeDate([&quot;Commands\Энергия по месяцам\Дата месяца&quot;].OldValue,y,m,d);
  if m=12 then
   begin
     
     m1Run:=([&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[1]&lt;0) and ([&quot;Commands\Энергия по месяцам\Массив энергии&quot;].NewValueAsArray[1]&lt;0);
     m1:=1;
     if j=m1 then
      m1Run:=false;
   end 
  else
   begin
   
    m1Run:=([&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m]&lt;0) and ([&quot;Commands\Энергия по месяцам\Массив энергии&quot;].NewValueAsArray[m]&lt;0);
    m1:=m+1;
    if j=m1 then
      m1Run:=false;
   end;  
  
  if m1Run then
   begin
    if m1&lt;=9 then
      s:='0'+inttostr(m1)
    else
      s:=inttostr(m1);
  
    [&quot;Command_[&quot;][0]:=ord(s[1]);
    [&quot;Command_[&quot;][1]:=ord(s[2]);
    [&quot;Command_[&quot;].run;
   end
  else
    SetEnOfMonth(m);
 
  
 except
  [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
 end; 

 
 
end;

procedure &lt;Command_T/&gt;OnBeforeWrite(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin
 [&quot;Кол-во запросов&quot;].NewValue:=[&quot;Кол-во запросов&quot;].OldValue+1;

end;

procedure &lt;Template/&gt;OnActivateDevice(Device:TIGDevice);
var i:integer;
begin
  [&quot;Имя шаблона&quot;].NewValue:=Device.TemplateName;
  for i:=0 to 11 do
   [&quot;Commands\Энергия по месяцам\Массив энергии&quot;].newvalueasarray[i]:=-1;

end;

procedure &lt;Дата получаса/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);

 
var d,mo,y:word;
    str:string;
    t,tx,cmin:double;
    dt:TDateTime;
begin
 cmin:=6.9444444444444444444444444444444e-4;
 try
  DecodeDate([&quot;Commands\Получасовые нагрузки\Дата получаса&quot;].vqt.value,y,mo,d);
  
  if mo&lt;=9 then
   str:='0'+inttostr(mo)
  else
   str:=inttostr(mo);
  
  [&quot;Command_?&quot;][0]:=ord(str[1]);
  [&quot;Command_?&quot;][1]:=ord(str[2]);
  
  if d&lt;=9 then
   str:='0'+inttostr(d)
  else
   str:=inttostr(d);
  
  [&quot;Command_?&quot;][2]:=ord(str[1]);
  [&quot;Command_?&quot;][3]:=ord(str[2]);
  
  dt:=[&quot;Commands\Получасовые нагрузки\Дата получаса&quot;].vqt.value;
  [&quot;Commands\Получасовые нагрузки\Дата получаса&quot;].NewValue:=dt;
  t:=dt-round(dt);
  {tx:=1/24;
  tx:=tx/2;}
  tx:=0.020833333333333333333333333333333;
  t:=t/tx;  
  
  mo:=round(t);
  if mo&lt;=9 then
   str:='0'+inttostr(mo)
  else
   str:=inttostr(mo);
  
  [&quot;Command_?&quot;][4]:=ord(str[1]);
  [&quot;Command_?&quot;][5]:=ord(str[2]);
  [&quot;Command_?&quot;].run;
  

 except
 end;



end;

procedure &lt;Command_?/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var s:string;
    i,ii,j:integer;
    en:dword;
begin
 if Command.count=0 then exit;
 {if DriverData.result&lt;&gt;0 then
  begin
   Command.run;
   exit;
  end;} 
 s:=chr(Command[4])+chr(Command[5]);
 j:=strtoint(s);
 for i:=0 to Device.Tags.count-1 do
  if Device.Tags[i].PropExists(5002) then
   if Device.Tags[i].Prop[5002].Value=j then
    begin
     if DriverData.result=0 then
      begin
       try
        s:='';
        for ii:=1 to 4 do
         s:=s+chr(DriverData[ii]);
        en:=strtoint(s); 
        s:=chr(DriverData[5]);
        en:=round(en*power(10,strtoint(s)));
        Device.Tags[i].NewValue:=en;
       except
         Device.Tags[i].NewQuality:=OPC_QUALITY_COMM_FAILURE;
       end;  
      end
     else
      Device.Tags[i].NewQuality:=OPC_QUALITY_COMM_FAILURE;
     break;  
    end;
  

end;



procedure &lt;Command_?1/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var s,strmo,strd:string;
    i:integer;
    dt:TDateTime;
    y,mo,d:word;
    mo1,d1:word;
    en:dword;
begin

  
 if DriverData.result=0 then
  begin
  if (DriverData.count=6) and (Command.count&gt;4) then
   begin
    try
     s:='';
     for i:=1 to 4 do
      s:=s+chr(DriverData[i]);
     en:=strtoint(s); 
     s:=chr(DriverData[5]); 
     en:=round(en*power(10,strtoint(s)));
     
     
     dt:=[&quot;Commands\Посуточное потребление\Дата суток&quot;].Oldvalue;
     DecodeDate(dt,y,mo,d); 
     mo1:=strtoint(chr(Command[0])+chr(Command[1]));
     d1:=strtoint(chr(Command[2])+chr(Command[3]));
     
     if (d&lt;&gt;d1) or (mo&lt;&gt;mo1) then
     
      begin
       
       [&quot;Commands\Посуточное потребление\Потребление на начало следующих суток&quot;].newvalue:=en;

       if mo&lt;=9 then
        strmo:='0'+inttostr(mo)
       else
        strmo:=inttostr(mo);
      
       if d&lt;=9 then
        strd:='0'+inttostr(d)
       else
        strd:=inttostr(d);
       
       [&quot;Command_?1&quot;][0]:=ord(strmo[1]);
       [&quot;Command_?1&quot;][1]:=ord(strmo[2]);
       [&quot;Command_?1&quot;][2]:=ord(strd[1]);
       [&quot;Command_?1&quot;][3]:=ord(strd[2]);
   
       [&quot;Command_?1&quot;][4]:=ord('0');
       [&quot;Command_?1&quot;][5]:=ord('0');
       [&quot;Command_?1&quot;].run; 
      end
     else
      begin
       if [&quot;Commands\Посуточное потребление\Потребление на начало следующих суток&quot;].Oldvalue&lt;en then
         en:=(99990-en)+[&quot;Commands\Посуточное потребление\Потребление на начало следующих суток&quot;].Oldvalue
       else
         en:=[&quot;Commands\Посуточное потребление\Потребление на начало следующих суток&quot;].OldValue-en;
        
        
       [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].newvalue:=en;   
      end;  
     
     except
      [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].newQuality:=OPC_QUALITY_COMM_FAILURE;
     end;  
   end
  else
   [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].newQuality:=OPC_QUALITY_COMM_FAILURE; 
  end
 else
  [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].newQuality:=OPC_QUALITY_COMM_FAILURE;
  

  

end;

procedure &lt;Нагрузка на 00:00/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
var d,mo,y,no:word;
    str,strmo,strd:string;
    dt:TDateTime;
    i:integer;
begin

 if [&quot;Commands\Получасовые нагрузки\Дата получаса&quot;].OldQuality&lt;&gt;OPC_QUALITY_GOOD then exit;
 try
  
  dt:=[&quot;Commands\Получасовые нагрузки\Дата получаса&quot;].OldValue;
  DecodeDate(dt,y,mo,d);

  if mo&lt;=9 then
   strmo:='0'+inttostr(mo)
  else
   strmo:=inttostr(mo);
  
  if d&lt;=9 then
   strd:='0'+inttostr(d)
  else
   strd:=inttostr(d);
  
  for i:=0 to Tags.count-1 do
  if Tags[i].PropExists(5002) then
   begin
          
          [&quot;Command_?&quot;][0]:=ord(strmo[1]);
          [&quot;Command_?&quot;][1]:=ord(strmo[2]);
          [&quot;Command_?&quot;][2]:=ord(strd[1]);
          [&quot;Command_?&quot;][3]:=ord(strd[2]);
          
          no:=Tags[i].Prop[5002].value;
          
          if no&lt;=9 then
           str:='0'+inttostr(no)
          else
           str:=inttostr(no);
          
          [&quot;Command_?&quot;][4]:=ord(str[1]);
          [&quot;Command_?&quot;][5]:=ord(str[2]);
          [&quot;Command_?&quot;].run;
          
          
  end;
  
  

 except
 end;



end;



procedure &lt;Дата суток/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var d,mo,y:word;
    strmo,strd:string;
    dt:TDateTime;
begin

 try
  dt:=[&quot;Commands\Посуточное потребление\Дата суток&quot;].vqt.value;
  [&quot;Commands\Посуточное потребление\Дата суток&quot;].Newvalue:=dt;
  dt:=dt+1;
  
  DecodeDate(dt,y,mo,d);
  if mo&lt;=9 then
   strmo:='0'+inttostr(mo)
  else
   strmo:=inttostr(mo);
  
  if d&lt;=9 then
   strd:='0'+inttostr(d)
  else
   strd:=inttostr(d);
  
  
  
  [&quot;Command_?1&quot;][0]:=ord(strmo[1]);
  [&quot;Command_?1&quot;][1]:=ord(strmo[2]);
  [&quot;Command_?1&quot;][2]:=ord(strd[1]);
  [&quot;Command_?1&quot;][3]:=ord(strd[2]);
  
  [&quot;Command_?1&quot;][4]:=ord('0');
  [&quot;Command_?1&quot;][5]:=ord('0');
  [&quot;Command_?1&quot;].run;
  
  
 except
 end;


end;





procedure &lt;Потребление за месяц/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
var y,m,m1,d:word;
    s:string;
    mRun,m1Run:boolean;
   
begin
 try
  DecodeDate([&quot;Commands\Энергия по месяцам\Дата месяца&quot;].Oldvalue,y,m,d);
 
  mRun:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m-1]&lt;0;
  if m=12 then
   begin
    m1Run:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[1]&lt;0;
    m1:=1;
   end 
  else
   begin
    m1Run:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m]&lt;0;
    m1:=m+1;
   end;  
  
  if mRun then
   begin
    if m&lt;=9 then
     s:='0'+inttostr(m)
    else
     s:=inttostr(m);
  
    [&quot;Command_[&quot;][0]:=ord(s[1]);
    [&quot;Command_[&quot;][1]:=ord(s[2]);
    [&quot;Command_[&quot;].run;
   end;

  if m1Run then
   begin
    if m1&lt;=9 then
     s:='0'+inttostr(m1)
    else
     s:=inttostr(m1);
  
    [&quot;Command_[&quot;][0]:=ord(s[1]);
    [&quot;Command_[&quot;][1]:=ord(s[2]);
    [&quot;Command_[&quot;].run;
   end;

  if m1Run or mRun then exit;
  
  SetEnOfMonth(m);
  


 except
 end; 


end;

procedure &lt;Дата месяца/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var y,m,m1,d:word;
    s:string;
    mRun,m1Run:boolean;
    dt:TDateTime;
begin
 try
  dt:=[&quot;Commands\Энергия по месяцам\Дата месяца&quot;].vqt.value;
  DecodeDate(dt,y,m,d);
  [&quot;Commands\Энергия по месяцам\Дата месяца&quot;].NewValue:=dt;
  mRun:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m-1]&lt;0;
  if mRun then
   begin
    if m&lt;=9 then
     s:='0'+inttostr(m)
    else
     s:=inttostr(m);
  
    [&quot;Command_[&quot;][0]:=ord(s[1]);
    [&quot;Command_[&quot;][1]:=ord(s[2]);
    [&quot;Command_[&quot;].run;
   end
  else
   begin 
    if m=12 then
     begin
      m1Run:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[1]&lt;0;
      m1:=1;
     end 
    else
     begin
      m1Run:=[&quot;Commands\Энергия по месяцам\Массив энергии&quot;].OldValueAsArray[m]&lt;0;
      m1:=m+1;
     end;  
  
    if m1Run then
     begin
      if m1&lt;=9 then
       s:='0'+inttostr(m1)
      else
       s:=inttostr(m1);
  
      [&quot;Command_[&quot;][0]:=ord(s[1]);
      [&quot;Command_[&quot;][1]:=ord(s[2]);
      [&quot;Command_[&quot;].run;
     end
    else
      SetEnOfMonth(m);
   end;   
  


 except
 end; 



end;

