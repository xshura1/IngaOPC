 [&quot;Command_34&quot;].run;

end;





procedure &lt;Command_25/&gt;OnBeforeWrite(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin
 [&quot;Statistics\Кол-во запросов&quot;].newvalue:=[&quot;Statistics\Кол-во запросов&quot;].oldValue+1;
end;


procedure &lt;Command_34/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
