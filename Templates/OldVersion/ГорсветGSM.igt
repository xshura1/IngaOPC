 SetOtvResult(DriverData.result);
 
end;



procedure &lt;Обнулить статистику/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
begin
  [&quot;Statistics\Кол-во запросов&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во не ответов&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во не ответов от драйвера&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во ответов&quot;].newvalue:=0;

end;



procedure &lt;IP address/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var i:integer;
begin
 [&quot;Command_55&quot;].count:=14;
 [&quot;Command_55&quot;][0]:=12;
 [&quot;Command_55&quot;][1]:=0;
 for i:=0 to 11 do
  [&quot;Command_55&quot;][i+2]:=[&quot;Commands\Дополнительно\IP адреса&quot;].vqt.ValueAsArray[i];
 [&quot;Command_55&quot;].run;
   

end;

procedure &lt;IP address/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_15&quot;].count:=3;
 [&quot;Command_15&quot;][0]:=12;
 [&quot;Command_15&quot;][1]:=$60;
 [&quot;Command_15&quot;][2]:=$03;
 [&quot;Command_15&quot;].run;

end;

procedure &lt;Command_15/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d:word;
    i:integer;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   
   d:=DriverData[2];
   d:=d shl 8;
   d:=d or DriverData[1];
   case d of
    $0360:begin
           for i:=3 to DriverData.Count-1 do
           [&quot;Commands\Дополнительно\IP адреса&quot;].newvalueasarray[i-3]:=DriverData[i];
           
          end;
    $036C:begin
           [&quot;Commands\Дополнительно\Номер порта TCP&quot;].newvalue:=makeword(DriverData[3],DriverData[4]);
          end;
    $0357:begin
           [&quot;Работа с EEPROM\No PDP context&quot;].newvalue:=DriverData[3];

          end;      
    $0329:begin
           [&quot;Работа с EEPROM\Байт конфигурации&quot;].newvalue:=DriverData[3];

          end;  
    $036F:[&quot;Commands\Дополнительно\Индекс IP адреса&quot;].newvalue:=DriverData[3];
    $0354:[&quot;Commands\Дополнительно\Режим двойной SIM карты&quot;].newvalue:=DriverData[3]=1;
    $0356:[&quot;Commands\Дополнительно\Кол-во пересбросов&quot;].newvalue:=makeword(DriverData[3],DriverData[4]);             
   end; 
  end
 else
  begin
   d:=Command[2];
   d:=d shl 8;
   d:=d or Command[1];
   case d of
    $0360:[&quot;Commands\Дополнительно\IP адреса&quot;].newquality:=opc_quality_bad;
    $036C:[&quot;Commands\Дополнительно\Номер порта TCP&quot;].newquality:=opc_quality_bad;
    $0357:[&quot;Работа с EEPROM\No PDP context&quot;].newquality:=opc_quality_bad;
    $0329:[&quot;Работа с EEPROM\Байт конфигурации&quot;].newquality:=opc_quality_bad;
    $036F:[&quot;Commands\Дополнительно\Индекс IP адреса&quot;].newquality:=opc_quality_bad;
    $0354:[&quot;Commands\Дополнительно\Режим двойной SIM карты&quot;].newquality:=opc_quality_bad;
    $0356:[&quot;Commands\Дополнительно\Кол-во пересбросов&quot;].newquality:=opc_quality_bad;
   end;                  
   
  end;  
end;

