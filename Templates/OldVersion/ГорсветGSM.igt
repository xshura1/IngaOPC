<Header FileDescription="IngaOPC Template File" Version="0101" Checked="-1" Script="
function BitStat (B1,B2:Word):boolean;
    begin
      if (B1 and (1 shl B2) &lt;&gt;0) then result:=true
      else result:=false;
    end;


procedure SetOtvResult(Res:dword);
var i:integer;
begin
 case Res of
  0:[&quot;Statistics\Кол-во ответов&quot;].newvalue:=[&quot;Statistics\Кол-во ответов&quot;].oldvalue+1;
  1:[&quot;Statistics\Кол-во не ответов&quot;].newvalue:=[&quot;Statistics\Кол-во не ответов&quot;].oldvalue+1;
  2:begin
     [&quot;Statistics\Кол-во не ответов от драйвера&quot;].newvalue:=[&quot;Statistics\Кол-во не ответов от драйвера&quot;].oldvalue+1;
     {if [&quot;Статистика\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Статистика\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Статистика\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end; }
    end; 
 end;   
 
 if Res&lt;&gt;0 then
  if [&quot;Statistics\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Statistics\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Statistics\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end;
 [&quot;Statistics\FlagOldResult&quot;].Newvalue:=Res;
 if Res=0 then
  [&quot;ShortSost&quot;].NewQuality:=OPC_QUALITY_GOOD
 else
  [&quot;ShortSost&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;



end;
 
procedure &lt;Состояние/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 if not FromGroup then
  [&quot;Command_27&quot;].run;
end;

procedure &lt;Дата и время/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_8&quot;].count:=1;
 [&quot;Command_8&quot;].run;
end;

procedure &lt;Дата и время/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
 var ss,s,m,h,d,mo,y:word;
begin
 try
 [&quot;Command_7&quot;].count:=7;
 DecodeDate([&quot;Commands\Дата и время&quot;].vqt.value,y,mo,d);
 DecodeTime([&quot;Commands\Дата и время&quot;].vqt.value,h,m,s,ss);
 [&quot;Command_7&quot;][0]:=s;
 [&quot;Command_7&quot;][1]:=m;
 [&quot;Command_7&quot;][2]:=h;
 [&quot;Command_7&quot;][3]:=d;
 [&quot;Command_7&quot;][4]:=mo;
 [&quot;Command_7&quot;][5]:=1;
 [&quot;Command_7&quot;][6]:=y-2000;
 [&quot;Command_7&quot;].run;
 except
 end;
end;


procedure &lt;Эл. счетчик/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var w:word;
    dw:dword;
begin
 
 [&quot;Command_36&quot;].count:=5;
 [&quot;Command_36&quot;][0]:=12;
 dw:=[&quot;Commands\Эл. счетчик&quot;].vqt.value;
 w:=word(dw);
 [&quot;Command_36&quot;][1]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][2]:=byte(w);
 
 w:=word(dw shr 16);
 [&quot;Command_36&quot;][3]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][4]:=byte(w);
 
 [&quot;Command_36&quot;].run;
 [&quot;Команда 27 подавалась&quot;].newvalue:=false;

end;



procedure &lt;Command_27/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var b:byte;
    sost:dword;
    w:word;
begin
 SetOtvResult(DriverData.result);
 
 if DriverData.result=0 then
  begin
   [&quot;Statistics\Кол-во принятых 27 команд&quot;].newvalue:=[&quot;Statistics\Кол-во принятых 27 команд&quot;].oldvalue+1;
   b:=DriverData[0];
   [&quot;TC\TC0&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC1&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC2&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC3&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC4&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC5&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC6&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC7&quot;].newvalue:=boolean(BitStat(b,7));
   b:=DriverData[1];
   [&quot;TC\TC8&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC9&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC10&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC11&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC12&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC13&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC14&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC15&quot;].newvalue:=boolean(BitStat(b,7));
   b:=DriverData[2];
   [&quot;TC\TC16&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC17&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC18&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC19&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC20&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC21&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC22&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC23&quot;].newvalue:=boolean(BitStat(b,7));
   
   
   
   [&quot;Commands\Эл. счетчик&quot;].newvalue:=MAKELONG(makeword(DriverData[5],DriverData[6]),
                                               makeword(DriverData[7],DriverData[8]));
                                               
   [&quot;TIT\TIT0&quot;].newvalue:=DriverData[9];
   [&quot;TIT\TIT1&quot;].newvalue:=DriverData[10];
   [&quot;TIT\TIT2&quot;].newvalue:=DriverData[11];
   [&quot;TIT\TIT3&quot;].newvalue:=DriverData[12];
   [&quot;TIT\TIT4&quot;].newvalue:=DriverData[13];
   [&quot;TIT\TIT5&quot;].newvalue:=DriverData[14];
   
    
 
   
   Case DriverData[15] and $3 of
    0:[&quot;Commands\Управление&quot;].NewValue:=2; // вечерний
    1:[&quot;Commands\Управление&quot;].NewValue:=1; // ночной
    3:[&quot;Commands\Управление&quot;].NewValue:=0; // отключен
   end; 
   
   
   b:=DriverData[3];
   [&quot;Commands\Охрана\Охрана внеш.&quot;].newvalue:=(b shr 2) and $3;
   [&quot;Commands\Охрана\Охрана внут.&quot;].newvalue:=b and $3;
   
   
   {  0-1 - режим работы пункта (0-отключен 1-ночной 2-вечерний)
      2   - тревога на пункте (0-нет тревоги 1-тревога)
      3-4 - логическое состояние охраны ВНЕШНЕЙ двери (0-взята 1-снята  2-тревога)
      5-6 - логическое состояние охраны ВНУТРЕННЕЙ двери (0-взята 1-снята 2-тревога)
      7   - физическое состояние ВНЕШНЕЙ двери (0-закрыта 1-открыта)
      8   - физическое состояние ВНУТРЕННЕЙ двери (0-закрыта 1-открыта)
      9   - пункт заблокирован (0-разблокирован 1-заблокирован)
      10  - блокировка ночного режима на пункте (0-ночной режим разблокирован 1-заблокирован)

  }
   
   
   
   sost:=[&quot;Commands\Управление&quot;].NewValue;
   w:=[&quot;Commands\Охрана\Охрана внут.&quot;].newvalue;
   sost:=sost or (w shl 3);
   w:=[&quot;Commands\Охрана\Охрана внеш.&quot;].newvalue;
   sost:=sost or (w shl 5);
   w:=DriverData[1];
   if (w and $20)&lt;&gt;$20 then // дверь внешняя
    begin
     w:=1;
     sost:=sost or (w shl 7); 
    end;
   
   if (w and $80)=$80 then // дверь внутренняя
    begin
     w:=1;
     sost:=sost or (w shl 8); 
    end;
   
   if not BitStat(DriverData[3],6) then
    begin
     sost:=sost or $200;
     [&quot;Commands\Блокировка ПВ&quot;].NewValue:=true;
    end
   else
    [&quot;Commands\Блокировка ПВ&quot;].NewValue:=false; 
   
   
   if not BitStat(DriverData[3],5) then
    begin
     sost:=sost or $400;
     [&quot;Commands\Блокировка ночного&quot;].NewValue:=true;
    end
   else
    [&quot;Commands\Блокировка ночного&quot;].NewValue:=false; 
      
   [&quot;ShortSost&quot;].newvalue:=Sost;
 
  end
 else
  begin
   
   [&quot;ShortSost&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
 
   [&quot;TC\TC0&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC1&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC2&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC3&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC4&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC5&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC6&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC7&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC8&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC9&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC10&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC11&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC12&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC13&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC14&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC15&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC16&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC17&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC18&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC19&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC20&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC21&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC22&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TC\TC23&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
   [&quot;Commands\Эл. счетчик&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT0&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT1&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT2&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT3&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT4&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;TIT\TIT5&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
   [&quot;Commands\Управление&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;Commands\Охрана\Охрана внеш.&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;Commands\Охрана\Охрана внут.&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;Commands\Блокировка ПВ&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   [&quot;Commands\Блокировка ночного&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
  end;              

end;
procedure &lt;Command_37/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
  
   [&quot;Commands\Время перехода в автономный режим&quot;].newvalue:=DriverData[0]*256+DriverData[1];
  end
 else
  begin
  
 
   [&quot;Commands\Время перехода в автономный режим&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
  end; 
end;

procedure &lt;Command_8/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var ss,s,m,h,d,mo,y:word;
    
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   
   s:=DriverData[0];
   m:=DriverData[1];
   h:=DriverData[2];
   d:=DriverData[3];
   mo:=DriverData[4];
   y:=DriverData[6]+2000;
   try
    [&quot;Commands\Дата и время&quot;].newvalue:=EncodeDate(y,mo,d);
    [&quot;Commands\Дата и время&quot;].newvalue:=[&quot;Commands\Дата и время&quot;].newvalue+EncodeTime(h,m,s,ss);
   except
    [&quot;Commands\Дата и время&quot;].newquality:=OPC_QUALITY_BAD; 
   end; 
  end
 else begin
  
 
   [&quot;Commands\Дата и время&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
  end;   

end;


procedure &lt;Время перехода в авт. режим/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_37&quot;].count:=1;
 [&quot;Command_37&quot;].run;
end;


