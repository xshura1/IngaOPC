procedure &lt;Статистика связи/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d:dword;
begin
 if DriverData.Count=0 then exit;
 d:=MakeLong(MakeWord(DriverData[1],DriverData[2]),MakeWord(DriverData[3],DriverData[4]));
 if DriverData[0]=0 then
  [&quot;Commands\Статистика\Передано байт&quot;].NewValue:=[&quot;Commands\Статистика\Передано байт&quot;].OldValue+d
 else
  [&quot;Commands\Статистика\Принято байт&quot;].NewValue:=[&quot;Commands\Статистика\Принято байт&quot;].OldValue+d;
 [&quot;Commands\Статистика\Всего байт&quot;].NewValue:=[&quot;Commands\Статистика\Принято байт&quot;].NewValue+[&quot;Commands\Статистика\Передано байт&quot;].NewValue;


end;

