procedure &lt;Command_32/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var str:string;
    
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   str:='График на: '+inttostr(DriverData[2])+'.'+inttostr(DriverData[1])+' ';
   str:=str+'Веч. '+inttostr(DriverData[3])+':'+inttostr(DriverData[4])+' ';
   str:=str+'Откл. '+inttostr(DriverData[6])+':'+inttostr(DriverData[7])+' ';
   str:=str+'Ноч. '+inttostr(DriverData[9])+':'+inttostr(DriverData[10])+' ';
   [&quot;Работа с графиком\График&quot;].NewValue:=str;
  end
 else
  begin
  [&quot;Работа с графиком\График&quot;].NewQuality:=opc_quality_bad;
  end;   

end;

procedure &lt;Дата графика/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var d,mo,y:word;
   
    sd:TDateTime;
begin
 sd:=[&quot;Работа с графиком\Дата графика&quot;].VQT.Value;
 try
  DecodeDate(sd,y,mo,d);
  [&quot;Command_32&quot;].count:=3;
  [&quot;Command_32&quot;][1]:=d;
  [&quot;Command_32&quot;][2]:=mo;
  [&quot;Command_32&quot;].run;
  [&quot;Работа с графиком\Дата графика&quot;].NewValue:=sd;
 except
  [&quot;Работа с графиком\Дата графика&quot;].NewQuality:=opc_quality_bad;
 end;  
end;



