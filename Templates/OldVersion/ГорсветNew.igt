 [&quot;Command_13&quot;].count:=1;
 case [&quot;Commands\Управление&quot;].VQT.Value of
  0:[&quot;Command_13&quot;][0]:=$3;
  1:[&quot;Command_13&quot;][0]:=$1;
  2:[&quot;Command_13&quot;][0]:=$0;
 end; 
 [&quot;Command_13&quot;].run;
end;

