  [&quot;Statistics\Кол-во запросов&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во не ответов&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во не ответов от драйвера&quot;].newvalue:=0;
  [&quot;Statistics\Кол-во ответов&quot;].newvalue:=0;

end;



procedure &lt;IP address/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
begin
 [&quot;Command_14&quot;].count:=7;
 [&quot;Command_14&quot;][0]:=4;
 [&quot;Command_14&quot;][1]:=$51;
 [&quot;Command_14&quot;][2]:=$03;
 
 [&quot;Command_14&quot;][3]:=[&quot;Работа с EEPROM\IP address&quot;].vqt.ValueAsArray[0];
 [&quot;Command_14&quot;][4]:=[&quot;Работа с EEPROM\IP address&quot;].vqt.ValueAsArray[1];
 [&quot;Command_14&quot;][5]:=[&quot;Работа с EEPROM\IP address&quot;].vqt.ValueAsArray[2];
 [&quot;Command_14&quot;][6]:=[&quot;Работа с EEPROM\IP address&quot;].vqt.ValueAsArray[3];
 
 [&quot;Command_14&quot;].run;
   

end;

procedure &lt;IP address/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_15&quot;].count:=3;
 [&quot;Command_15&quot;][0]:=4;
 [&quot;Command_15&quot;][1]:=$51;
 [&quot;Command_15&quot;][2]:=$03;
 [&quot;Command_15&quot;].run;

end;

procedure &lt;Command_15/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d:word;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   
   d:=DriverData[2];
   d:=d shl 8;
   d:=d or DriverData[1];
   case d of
    $0351:begin
           [&quot;Работа с EEPROM\IP address&quot;].newvalueasarray[0]:=DriverData[3];
           [&quot;Работа с EEPROM\IP address&quot;].newvalueasarray[1]:=DriverData[4];
           [&quot;Работа с EEPROM\IP address&quot;].newvalueasarray[2]:=DriverData[5];
           [&quot;Работа с EEPROM\IP address&quot;].newvalueasarray[3]:=DriverData[6];
          end;
    $0355:begin
           [&quot;Работа с EEPROM\Номер порта&quot;].newvalue:=makeword(DriverData[3],DriverData[4]);
          end;
    $0357:begin
           [&quot;Работа с EEPROM\No PDP context&quot;].newvalue:=DriverData[3];

          end;      
    $0329:begin
           [&quot;Работа с EEPROM\Байт конфигурации&quot;].newvalue:=DriverData[3];

          end;                 
   end; 
  end
 else
  begin
   d:=Command[2];
   d:=d shl 8;
   d:=d or Command[1];
   case d of
    $0351:[&quot;Работа с EEPROM\IP address&quot;].newquality:=opc_quality_bad;
    $0355:[&quot;Работа с EEPROM\Номер порта&quot;].newquality:=opc_quality_bad;
    $0357:[&quot;Работа с EEPROM\No PDP context&quot;].newquality:=opc_quality_bad;
    $0329:[&quot;Работа с EEPROM\Байт конфигурации&quot;].newquality:=opc_quality_bad;
   end;                  
   
  end;  
end;

