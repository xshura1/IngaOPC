procedure &lt;Command_100/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d,mo,y:word;
    str:string;
    sd:TDateTime;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   str:='Версия: '+inttostr(DriverData[0])+' Build: '+inttostr(DriverData[1]);
   d:=DriverData[2];
   mo:=DriverData[3];
   y:=DriverData[4]+2000;
   try
    sd:=EncodeDate(y,mo,d);
    str:=str+' Дата: '+DateToStr(sd);
    [&quot;Commands\Дополнительно\Версия прошивки&quot;].newvalue:=str; 
   except
   [&quot;Commands\Дополнительно\Версия прошивки&quot;].newquality:=opc_quality_bad; 
   end; 
  end
 else
  begin
   [&quot;Commands\Дополнительно\Версия прошивки&quot;].NewQuality:=opc_quality_bad;
  end;   


end;

procedure &lt;Версия прошивки/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_100&quot;].count:=1;
 [&quot;Command_100&quot;].run;
end;

procedure &lt;ShortSost/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Command_25&quot;].run;
end;



procedure &lt;Заблокирован/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
begin
 [&quot;Command_35&quot;].count:=1;
 if [&quot;Commands\Блокировка ночного&quot;].VQT.Value then 
  [&quot;Command_35&quot;][0]:=0
 else
  [&quot;Command_35&quot;][0]:=1; 

 [&quot;Command_35&quot;].run;
end;



procedure &lt;Режим освещения/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
begin
 [&quot;Command_13&quot;].count:=1;
 case [&quot;Режим освещения&quot;].VQT.Value of
  1:[&quot;Command_13&quot;][0]:=$3;
  2:[&quot;Command_13&quot;][0]:=$1;
  3:[&quot;Command_13&quot;][0]:=$0;
 end; 
 [&quot;Command_13&quot;].run;
end;


procedure &lt;Command_32/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var str:string;
    
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   str:='График на: '+inttostr(DriverData[2])+'.'+inttostr(DriverData[1])+' ';
   str:=str+'Веч. '+inttostr(DriverData[3])+':'+inttostr(DriverData[4])+' ';
   str:=str+'Откл. '+inttostr(DriverData[6])+':'+inttostr(DriverData[7])+' ';
   str:=str+'Ноч. '+inttostr(DriverData[9])+':'+inttostr(DriverData[10])+' ';
   [&quot;Работа с графиком\График&quot;].NewValue:=str;
  end
 else
  begin
  [&quot;Работа с графиком\График&quot;].NewQuality:=opc_quality_bad;
  end;   

end;

procedure &lt;Дата графика/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var d,mo,y:word;
   
    sd:TDateTime;
begin
 sd:=[&quot;Работа с графиком\Дата графика&quot;].VQT.Value;
 try
  DecodeDate(sd,y,mo,d);
  [&quot;Command_32&quot;].count:=3;
  [&quot;Command_32&quot;][1]:=d;
  [&quot;Command_32&quot;][2]:=mo;
  [&quot;Command_32&quot;].run;
  [&quot;Работа с графиком\Дата графика&quot;].NewValue:=sd;
 except
  [&quot;Работа с графиком\Дата графика&quot;].NewQuality:=opc_quality_bad;
 end;  
end;

procedure &lt;Command_25/&gt;OnBeforeWrite1(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin  
 if [&quot;TC\TC0&quot;].OldQuality&lt;&gt;OPC_QUALITY_GOOD then
  begin
   Cancel:=true;
   if not [&quot;Полный опрос&quot;].OldValue then
    begin
     [&quot;Полный опрос&quot;].NewValue:=true;
     [&quot;Command_27&quot;].run;
    end; 
  end
 else  
  [&quot;Statistics\Кол-во запросов&quot;].newvalue:=[&quot;Statistics\Кол-во запросов&quot;].oldValue+1;
end;

procedure &lt;Template/&gt;OnActivateDevice(Device:TIGDevice);
begin
 [&quot;Полный опрос&quot;].NewValue:=false;
 [&quot;Имя шаблона&quot;].NewValue:=Device.TemplateName;

end;

