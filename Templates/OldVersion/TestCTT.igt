    11: (asvt_ui4  : longword );
  end;
 }
procedure OnWrite(Device:TIGDevice; Tags:TIGTags);
var i:smallint;
    W:VARIANT;
begin
 i:=[&quot;Tag2&quot;].VQT.Value;
 
 w:=[&quot;Tag2&quot;].VQT.Value;
 
 IGConverter.SetValue(w);
 [&quot;CommandWrite&quot;].count:=2;
 
 [&quot;CommandWrite&quot;][0]:=IGConverter.bytes[0];
 [&quot;CommandWrite&quot;][1]:=IGConverter.bytes[1];
 
 {[&quot;CommandWrite&quot;][0]:=Byte(i);
 [&quot;CommandWrite&quot;][1]:=Byte(i shr 8);}
 [&quot;CommandWrite&quot;].run;
 

end;



procedure &lt;Tag2/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
var dt:word;
begin
 dt:=[&quot;Tag&quot;].DataType;
                   
//   [&quot;CommandRead&quot;][8]:=3;
   [&quot;CommandRead&quot;].count:=1;
   [&quot;CommandRead&quot;].run;
end;   
             
procedure &lt;Command2/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var w:variant;
begin
 w:=[&quot;Tag2&quot;].newvalue;
 IGConverter.SetValue(w);
 IGConverter.Bytes[0]:=DriverData[0];
 IGConverter.Bytes[1]:=DriverData[1];
 [&quot;Tag2&quot;].newvalue:=w;
 //[&quot;Tag2&quot;].newvalue:=smallint(makeword(DriverData[0],DriverData[1]));

end;

procedure &lt;CommandRead/&gt;OnBeforeWrite(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin
