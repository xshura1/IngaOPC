<Header FileDescription="IngaOPC Template File" Version="0101" Checked="-1" Script="procedure OpenCannel;
var s:string;
    i:integer;
begin
 s:=[&quot;Setup\Пароль счетчика&quot;].OldValue;
 for i:=1 to Length(s) do
  [&quot;Открыть канал связи&quot;][i-1]:=ord(s[i]);
 [&quot;Открыть канал связи&quot;].run;

end;

procedure CloseCannel;
begin
 [&quot;Закрыть канал связи&quot;].run;

end;

procedure &lt;Канал связи открыт/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);

begin
end;

procedure &lt;Энергия от сброса/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Чтение регистров накопленной энергии&quot;][0]:=0;
 [&quot;Чтение регистров накопленной энергии&quot;][1]:=1;
 [&quot;Чтение регистров накопленной энергии&quot;].run;
end;

procedure &lt;Чтение регистров накопленной энергии/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var dw:DWORD;
begin
 if DriverData.result=0 then
  begin
   dw:=MakeLong(MakeWord(DriverData[3],DriverData[2]),MakeWord(DriverData[1],DriverData[0]));
   
   [&quot;Текущее потребление&quot;].NewValue:=((dw/(2*[&quot;Setup\Постоянная счетчика&quot;].OldValue))*
                                      [&quot;Setup\Коэффициенты\Kt&quot;].OldValue*[&quot;Setup\Коэффициенты\Ku&quot;].OldValue)/1000;
  end
 else
  [&quot;Текущее потребление&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
end;

procedure &lt;Январь/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
var nm,b:byte;
    i:integer;
begin
 for i:=0 to Tags.Count-1 do
  if Tags[i].PropExists(5000) then
   begin
    nm:=Tags[i].Prop[5000].Value;
    b:=(3 shl 4) or nm;
    [&quot;Чтение энергии по месяцам&quot;][0]:=b;
    [&quot;Чтение энергии по месяцам&quot;][1]:=0;
    [&quot;Чтение энергии по месяцам&quot;].run;
   end;
end;

procedure &lt;Timer/&gt;OnTimer(Device:TIGDevice; Timer:TIGTimer);

begin

end;

procedure &lt;Чтение энергии по месяцам/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var nm:byte;
    dw:DWORD;
    y,m,d:word;
    dt:TDateTime;
begin
 try
 nm:=Command[0] and $F;
 if DriverData.result=0 then
  begin
   if DriverData.count&gt;1 then 
    begin
     dw:=MakeLong(MakeWord(DriverData[3],DriverData[2]),MakeWord(DriverData[1],DriverData[0]));
     dt:=[&quot;Commands\Энергия по месяцам\Дата месяца&quot;].OldValue;
     DecodeDate(dt,y,m,d);
     if m=nm then
      [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewValue:=round(dw/(2*[&quot;Setup\Постоянная счетчика&quot;].OldValue))
     else
      [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
       

    end
     else
      begin
       if DriverData.count=1 then
        if DriverData[0]=5 then
         opencannel;
       [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
      end; 
  end
 else
  [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;   
 except
  [&quot;Commands\Энергия по месяцам\Потребление за месяц&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
 end; 
  
end;

procedure &lt;Template/&gt;OnActivateDevice(Device:TIGDevice);
var s:string;
    i:integer;
begin
// [&quot;Канал связи открыт&quot;].newValue:=false;
//  OpenCannel;
  

 s:=[&quot;Setup\Пароль счетчика&quot;].OldValue;
 for i:=1 to Length(s) do
  [&quot;Загрузить пароль&quot;][i-1]:=ord(s[i]);
 [&quot;Загрузить пароль&quot;].run; 
 
 [&quot;Чтение начала массива&quot;][0]:=0;
 [&quot;Чтение начала массива&quot;][1]:=0;
 [&quot;Чтение начала массива&quot;][2]:=4;
 [&quot;Чтение начала массива&quot;].run;
 
end;

procedure &lt;Template/&gt;OnDeactivateDevice(Device:TIGDevice);
begin
 CloseCannel;  
end;

procedure &lt;Открыть канал связи/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
begin
 if DriverData.result=0 then
  begin
   if DriverData[0]=0 then
    [&quot;Канал связи открыт&quot;].NewValue:=true;
  end;
end;

procedure &lt;Чтение регистров накопленной энергии/&gt;OnBeforeWrite(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin
 if not [&quot;Канал связи открыт&quot;].OldValue then
  opencannel;
 // Cancel:=true; 
end;

procedure &lt;Дата суток/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var d,mo,y:word;
    dt:TDateTime;
begin
 try
  dt:=[&quot;Commands\Посуточное потребление\Дата суток&quot;].vqt.value;
  [&quot;Commands\Посуточное потребление\Дата суток&quot;].Newvalue:=dt;
  DecodeDate(dt,y,mo,d);
  [&quot;Чтение энергии за сутки&quot;][0]:=d;
  [&quot;Чтение энергии за сутки&quot;][1]:=0;
  [&quot;Чтение энергии за сутки&quot;][2]:=$FF;
  [&quot;Чтение энергии за сутки&quot;][3]:=0;
  [&quot;Чтение энергии за сутки&quot;].run;
 except
 end;
end;

procedure &lt;Чтение энергии за сутки/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var dw:DWORD;
begin
 if DriverData.result=0 then
  begin
   if DriverData.count&gt;1 then 
    begin
     dw:=MakeLong(MakeWord(DriverData[3],DriverData[2]),MakeWord(DriverData[1],DriverData[0]));
     [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].NewValue:=round(dw/(2*[&quot;Setup\Постоянная счетчика&quot;].OldValue));
    end
   else
    begin
       if DriverData.count=1 then
        if DriverData[0]=5 then
         opencannel;
       [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
    end;   
  end
 else
   [&quot;Commands\Посуточное потребление\Потребление за сутки&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
    
   
end;

procedure &lt;Дата на счетчике/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Чтение даты на счетчике&quot;].run;
end;

procedure &lt;Чтение даты на счетчике/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var y,m,d,hh,mm,ss:word;
    dt:TDateTime;
begin
 if DriverData.result=0 then
  begin
   if DriverData.Count=8 then
    begin
     ss:=strtoint(inttohex(DriverData[0],2));
     mm:=strtoint(inttohex(DriverData[1],2));
     hh:=strtoint(inttohex(DriverData[2],2));
     d :=strtoint(inttohex(DriverData[4],2)); 
     m :=strtoint(inttohex(DriverData[5],2));
     y :=strtoint(inttohex(DriverData[6],2)); 
     try
      dt:=EncodeDate(y+2000,m,d);
      dt:=EncodeTime(hh,mm,ss,0)+dt;
      [&quot;Дата на счетчике&quot;].NewValue:=dt;
     except
      [&quot;Дата на счетчике&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
     end;
    end
   else
    [&quot;Дата на счетчике&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
  end
 else
  [&quot;Дата на счетчике&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
end;

procedure &lt;Дата месяца/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var b:byte;
    y,m,d:word;
    dt:TDateTime;
begin
 dt:=[&quot;Commands\Энергия по месяцам\Дата месяца&quot;].vqt.value;
 [&quot;Commands\Энергия по месяцам\Дата месяца&quot;].NewValue:=dt;
 try
  DecodeDate(dt,y,m,d);
  b:=(3 shl 4) or m;
  [&quot;Чтение энергии по месяцам&quot;][0]:=b;
  [&quot;Чтение энергии по месяцам&quot;][1]:=0;
  [&quot;Чтение энергии по месяцам&quot;].run;
 except
 end;
 
end;

