begin

end;

procedure &lt;Указатель профиля мощности/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
  [&quot;Чтение текущего указателя профиля мощности&quot;].run;

end;

procedure &lt;Чтение текущего указателя профиля мощности/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
begin
 if DriverData.result=0 then
  begin
   if DriverData.Count=7 then
    begin
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[0]:=DriverData[0];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[1]:=DriverData[1];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[2]:=DriverData[2];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[3]:=DriverData[3];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[4]:=DriverData[4];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[5]:=DriverData[5];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[6]:=DriverData[6];
     [&quot;Указатель профиля мощности&quot;].NewValueAsArray[7]:=DriverData[7];
    end
   else
   [&quot;Указатель профиля мощности&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
  end
 else
  [&quot;Указатель профиля мощности&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
end;

procedure &lt;Начальный массив энергии/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
 [&quot;Чтение начала массива&quot;][0]:=0;
 [&quot;Чтение начала массива&quot;][1]:=0;
 [&quot;Чтение начала массива&quot;][2]:=4;
 [&quot;Чтение начала массива&quot;].run;
end;

procedure &lt;Чтение начала массива/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var y,m,d,hh:word;
    dt:TDateTime;
begin
 if DriverData.result=0 then
  begin
   if DriverData.Count=4 then
    begin
     hh:=strtoint(inttohex(DriverData[0],2));
     d :=strtoint(inttohex(DriverData[1],2)); 
     m :=strtoint(inttohex(DriverData[2],2));
     y :=strtoint(inttohex(DriverData[3],2)); 
     try
      dt:=EncodeDate(y+2000,m,d);
      dt:=EncodeTime(hh,0,0,0)+dt;
      [&quot;Дата и время нулевого указателя&quot;].NewValue:=dt;
     except
       [&quot;Дата и время нулевого указателя&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
     end;  

    end
   else
   [&quot;Дата и время нулевого указателя&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
  end
 else       
  [&quot;Дата и время нулевого указателя&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
end;

procedure &lt;Чтение начала массива/&gt;OnBeforeWrite(Device:TIGDevice; Command:TIGCommand; var Cancel:boolean);
begin
 if not [&quot;Канал связи открыт&quot;].OldValue then
  opencannel;
end;

procedure &lt;Дата и время нулевого указателя/&gt;OnRead(Device:TIGDevice; Tags:TIGTags; FromGroup:boolean);
begin
