cription="" Name="Май" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="42" Description="" OIDLink="37" Value="03000500000002000000"/></T120><T120 OID="30" Description="" Name="Июнь" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="43" Description="" OIDLink="37" Value="03000600000002000000"/></T120><T120 OID="31" Description="" Name="Июль" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="44" Description="" OIDLink="37" Value="03000700000002000000"/></T120><T120 OID="32" Description="" Name="Август" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="45" Description="" OIDLink="37" Value="03000800000002000000"/></T120><T120 OID="33" Description="" Name="Сентябрь" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="46" Description="" OIDLink="37" Value="03000900000002000000"/></T120><T120 OID="36" Description="" Name="Октябрь" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="47" Description="" OIDLink="37" Value="03000A00000002000000"/></T120><T120 OID="34" Description="" Name="Ноябрь" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="48" Description="" OIDLink="37" Value="03000B00000002000000"/></T120><T120 OID="35" Description="" Name="Декабрь" DataType="19" Readable="True" Writeable="False" OnRead="&lt;Январь/&gt;OnRead" OnWrite=""><T145 OID="49" Description="" OIDLink="37" Value="03000C00000002000000"/></T120><T120 OID="63" Description="" Name="Потребление за месяц" DataType="19" Readable="True" Writeable="False" OnRead="" OnWrite=""/><T120 OID="64" Description="" Name="Дата месяца" DataType="7" Readable="True" Writeable="True" OnRead="" OnWrite="&lt;Дата месяца/&gt;OnWrite"/></T50><T50 OID="54" Description="" Na