{ TOPCItemEnumerator }

procedure TOPCItemEnumerator.AddItem(Item:pointer);
begin
 FOPCItemList.Add(Item);
end;

function TOPCItemEnumerator.Clone(
  out ppEnumItemAttributes: IEnumOPCItemAttributes): HResult;
var i:integer;
    e:TOPCItemEnumerator;
begin
  try
    e:=TOPCItemEnumerator.Create;
    for i:=0 to fOPCItemList.Count-1 do
     e.AddItem(fOPCItemList[i]);
    ppEnumItemAttributes :=e; // TOPCItemEnumerator.Create(FOPCItemList);

    Result := S_OK;
  except
    Result := E_UNEXPECTED;
  end;

end;

constructor TOPCItemEnumerator.Create;
begin
  inherited Create;
  FOPCItemList := TList.Create;
  nextIndex := 0;
end;

destructor TOPCItemEnumerator.destroy;
begin
  fOPCItemList.Free;
  inherited;
end;

function TOPCItemEnumerator.Next(celt: cardinal;
  out ppItemArray: POPCITEMATTRIBUTESARRAY;
  out pceltFetched: cardinal): HResult;
var
 i: cardinal;
 item:THAOPCItem;
 Prop:TIGProp;
begin
  i := 0;
  pceltFetched := i;
  result:=s_false;

  if celt < 1 then
    exit;

 //if pceltFetched = nil then
 //  Exit;


 // Result := E_FAIL;
  ppItemArray :=OPCTaskMemAlloc(Result,sizeof(OPCITEMATTRIBUTES),celt);
  if ppItemArray = nil then
    exit;


{  if (nextIndex >= cardinal(FOPCItemList.Count)) then begin
    Result := RPC_X_ENUM_VALUE_OUT_OF_RANGE;
    exit;
  end;
 }

  // Einträge verarbeiten
  while (i < celt) and (nextIndex < cardinal(FOPCItemList.Count)) do
   begin
    //sOPCItem(FOPCItemList[nextIndex]).GetOPCItemAttributes(ppItemArray[i]);
    item:=FOPCItemList[nextIndex];
    ppItemArray[i].szAccessPath:=StringToLPOleStr('');
    ppItemArray[i].szItemID:=StringToLPOleStr(Item.FullName);
    ppItemArray[i].bActive:=Item.Active;
    ppItemArray[i].hClient:=Item.ClientHandle;
    ppItemArray[i].hServer:=Item.ServerHandle;
    ppItemArray[i].dwAccessRights:=Item.AccessRight;
    ppItemArray[i].dwBlobSize:=0;
    ppItemArray[i].pBlob:=nil;
    ppItemArray[i].vtRequestedDataType:=Item.RequestedDatatype;
    ppItemArray[i].vtCanonicalDataType:=Item.CanonicalDataType;

    Prop:=Item.Prop[7];
    if Prop<>nil then
     ppItemArray[i].dwEUType:=Prop.Value
    else
     ppItemArray[i].dwEUType:=vt_empty;

    Prop:=Item.Prop[8];
    if Prop<>nil then
     ppItemArray[i].vEUInfo:=Prop.Value
    else
     ppItemArray[i].vEUInfo:=vt_empty;

    inc(i);
    inc(nextIndex);
  end;


  pceltFetched := i;
  if i = celt then Result := S_OK;

end;

function TOPCItemEnumerator.Reset: HResult;
begin
 nextIndex := 0;
 Result := S_OK;
end;

function TOPCItemEnumerator.Skip(celt: cardinal): HResult;
begin
  if (nextIndex + celt) <= cardinal(FOPCItemList.Count) then begin
    nextIndex := nextIndex + celt;
    Result := S_OK;
  end else begin
    nextIndex := FOPCItemList.Count;
    Result := S_FALSE;
  end;
end;

initialization
 TComObjectFactory.Create(ComServer,
                            TOPCStringsEnumerator,
                            IEnumString,
                            'TOPCStringsEnumerator',
                            'HA',
                            ciInternal,
                            tmApartment);
 TComObjectFactory.Create(ComServer,
                            TOPCUnknownEnumerator,
                            IEnumUnknown,
                            'TOPCUnknownEnumerator',
                            'HA',
                            ciInternal,
                            tmApartment);
 TComObjectFactory.Create(ComServer,
                          TOPCItemEnumerator,
                          IID_IEnumOPCItemAttributes,
                          'TOPCItemEnumerator',
                          'HA',
                          ciInternal,
                          tmApartment);

end.
