; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=IngaOPC Server Demo
AppVerName=IngaOPC Server Demo
AppPublisher=Интеграл+
AppPublisherURL=http://www.integralplus.ru
AppSupportURL=http://www.integralplus.ru
AppUpdatesURL=http://www.integralplus.ru
DefaultDirName={pf}\IngaOPC Server
DefaultGroupName=IngaOPC Server
OutputBaseFilename=IngaOPCSetup
SetupIconFile=C:\work\IngaOPC\Bitmap\Icons32_32\IngaOPCAll.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
 Name: "{app}\Templates"
 Name: "{app}\Configs"
 Name: "{app}\Dll"
 Name: "{app}\Dll\Modbus"


[Files]
Source: "C:\work\IngaOPC\IngaOPC.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\work\IngaOPC\Setup\IngaOPC.ini"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\work\IngaOPC\IngaOPCHelp.chm"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\work\IngaOPC\Changes.txt"; DestDir: "{app}"; Flags: ignoreversion

Source: "C:\work\IngaOPC\configs\ExampleConfig.igc"; DestDir: "{app}\configs"; Flags: ignoreversion
Source: "C:\work\IngaOPC\templates\ExampleModbus.igt"; DestDir: "{app}\templates"; Flags: ignoreversion

Source: "C:\work\IngaOPC\dll\ModBus.INI"; DestDir: "{app}\Dll"; Flags: ignoreversion
Source: "C:\work\IngaOPC\dll\Intf.pas"; DestDir: "{app}\Dll"; Flags: ignoreversion
Source: "C:\work\IngaOPC\dll\ModBus.dll"; DestDir: "{app}\Dll"; Flags: ignoreversion

Source: "C:\work\IngaOPC\dll\Modbus\*"; DestDir: "{app}\Dll\Modbus"; Flags: ignoreversion recursesubdirs createallsubdirs


 
[Icons]
Name: "{group}\IngaOPC Server"; Filename: "{app}\IngaOPC.exe"
Name: "{group}\Help"; Filename: "{app}\IngaOPCHelp.chm"

Name: "{userdesktop}\IngaOPC Server"; Filename: "{app}\IngaOPC.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\IngaOPC.exe"; Parameters: "/regserver"; Description: "{cm:LaunchProgram,IngaOPC Server}";
Filename: "{app}\IngaOPC.exe";  Description: "{cm:LaunchProgram,IngaOPC Server}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{app}\IngaOPC.exe"; Parameters: "/unregserver";
;function CheckForMutexes(Mutexes: String): Boolean; B9CBDC2D-AEFD-4779-A95E-758C39501DF6

[code]
function InitializeUninstall(): Boolean;
begin
 result:=not CheckForMutexes('B9CBDC2D-AEFD-4779-A95E-758C39501DF6');
 if not result then
  MsgBox('IngaOPC Server запущен.'+#13#10#13#10+'Удаление невозможно.', mbError, MB_OK);
end;


