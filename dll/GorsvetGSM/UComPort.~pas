procedure TComPort.SetCountBytes(IsWrite: boolean; CountBytes,Addr: dword);
var pDD:pDriverData;
    ac:TAddrConv;
    i:integer;
begin
 if CountBytes=0 then exit;
 pdd:=coTaskMemAlloc(sizeof(DriverData));
 pdd^.Handle:=0;
 pdd^.szAddress:=stringtolpolestr(DWordToStrAddr(Addr));
 pdd^.szNoCommand:=stringtolpolestr('_1');
 pdd^.Result:=s_ok;
 pdd^.dwDataSize:=5;
 pdd^.pData:=coTaskMemAlloc(pdd^.dwDataSize);
 if IsWrite then
  pdd^.pData[0]:=0
 else
  pdd^.pData[0]:=1;
  
 ac.wAddr:=CountBytes;
 for i:=0 to High(ac.bAddr) do
  pdd^.pData[i+1]:=ac.bAddr[i];
 fListResult.Add(pdd);

end;

