function BitStat (B1,B2:DWord):Dword;
    { Пpовеpяет состояние бита    }
    { B1 - число, B2 - номеp бита }
    begin
      if (B1 and (1 shl B2) <>0) then result:=1
      else result:=0;
    end;

function BitSet(B1:DWord;B2:DWord;B3:Byte):Dword;
    { Устанавливает опpеделённый бит в 0 или 1 }
    { B1 - число, B2 - номеp бита, B3 - флаг   }
    begin
    if B3=1 then result:= B1 or ( 1 shl B2 )
     else result:= B1 and  not(1 shl B2) ;
    end;


function Key16ToString(Key16:TKey16):string;
var i:integer;
begin
 result:='';
 for i:=0 to High(Key16) do
  result:=result+chr(Key16[i]);
end;

function StrAddrToDword(StrAddr:string; var Addr:dword):boolean;
var Len,i,j:integer;
    ac:TAddrConv;
    s,s1:string;
begin

 result:=true;
 try
  ac.wAddr:=0;
  s:=StrAddr;
  len:=length(s);
  j:=0; s1:='';
  for i:=1 to len do
   if (s[i]<>'.') and (i<len) then
    s1:=s1+s[i]
   else
    begin
     if i=len then
       s1:=s1+s[i];
     ac.bAddr[j]:=strtoint(s1);

     inc(j);
     s1:='';
    end;
  Addr:=ac.wAddr;
 except
  result:=false;
 end;
end;

function DWordToStrAddr(Addr:dword):string;
var ac:TAddrConv;
    i:integer;
begin
 result:='';
 ac.wAddr:=Addr;
 for i:=0 to High(ac.bAddr) do
  if result='' then
   result:=inttostr(ac.bAddr[i])
  else
   result:=result+'.'+inttostr(ac.bAddr[i]);
end;


function GetModuleFileNameStr(Instance: THandle; FullPath:boolean): String;
var
  buffer : array [0..MAX_PATH] of Char;
  i:integer;
  s:string;
begin
  GetModuleFileName( Instance, buffer, MAX_PATH);
  s := buffer;
  result:=s;
  if FullPath then exit;
  result:='';
  for i:=length(s) downto 1 do
   if s[i]<>'\' then
    result:=s[i]+result
   else
    break;

end;


