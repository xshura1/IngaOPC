procedure EncryptPaket(const BI:TBuff; const CK:string; out BO:TBuff; out SizeO:dword);
var bc:array [0..15] of byte;
    bout:array [0..15] of byte;
    i,ii,cbl,j,ei:integer;
    ac:TAesContext;
    crc:word;
begin
 fillchar(bo,sizeof(bo),0);
 sizeo:=0;
 for i:=0 to 6 do bo[i]:=bi[i];

 // вычисляем кол-во блоков по 16 байт криптованного пакета
 cbl:=((bi[1]+6) div 16);
 if ((bi[1]+6) mod 16)>0 then
  cbl:=cbl+1;

 j:=7;
 i:=aes_set_encrypt_key(PChar(ck),16,ac);

 // криптуем по блокам
 for i:=0 to cbl-1 do
  begin
   for ii:=0 to 15 do
    bc[ii]:=bi[ii+j];
   aes_encrypt_block(bc,bout,ac);
   for ii:=0 to 15 do
    bo[ii+j]:=bout[ii];
   inc(j,16);
  end;

 // вычисляем конечный индекс шифрованного пакета
 ei:=7+(cbl*16)-1;
 crc:=CalcCRC(bo,0,ei);
 bo[ei+1]:=HiByte(crc);
 bo[ei+2]:=LoByte(crc);
 SizeO:=ei+3;
end;

procedure DecryptPaket(const BI:TBuff; const FI,SizeI:dword; const CK:string; out BO:TBuff; out SizeO:dword);
var bc:array [0..15] of byte;
    bout:array [0..15] of byte;
    i,ii,cbl,j:integer;
    ac:TAesContext;



begin
 fillchar(bo,sizeof(bo),0);
 sizeo:=0;
 for i:=0 to 6 do bo[i]:=bi[FI+i];

 // вычисляем кол-во блоков по 16 байт криптованного пакета
 cbl:=((bi[FI+1]+6) div 16);
 if ((bi[FI+1]+6) mod 16)>0 then
  cbl:=cbl+1;

 j:=FI+7;
 aes_set_decrypt_key(PChar(ck),16,ac);

 for i:=0 to cbl-1 do
  begin
   for ii:=0 to 15 do
    bc[ii]:=bi[ii+j];
   aes_decrypt_block(bc,bout,ac);
   for ii:=0 to 15 do
    bo[ii+j-FI]:=bout[ii];
   inc(j,16);
  end;

 SizeO:=bo[1]+7+6;

end;


procedure TComPort.CreateNullResult(ppDriverData:pDriverData);
var pDD:pDriverData;
begin
 pdd:=coTaskMemAlloc(sizeof(DriverData));
 pdd^.Handle:=ppDriverData^.Handle;
 pdd^.szAddress:=nil;
 pdd^.szNoCommand:=nil;//stringtolpolestr(ppDriverData^.szNoCommand);
 pdd^.Result:=s_ok;
 pdd^.pData:=nil;
 pdd^.dwDataSize:=0;
 fListResult.Add(pdd);
end;









