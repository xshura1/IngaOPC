constructor TComPort.Create;
begin
 inherited;
 fListResult:=TThreadList.Create;
 fListParams:=TList.Create;

 InitializeCriticalSection(fCS);

 fTCPServer:=TIdTCPServer.Create(nil);
 fTCPServer.OnExecute:=OnExecute;
 fTCPServer.OnConnect:=Onconnect;
 fTCPServer.OnDisconnect:=OnDisconnect;
 fTimeOutRead:=10000;
 Randomize;
 //ResetPort;
end;

destructor TComPort.Destroy;
begin
  ClosePort;
  ClearObj;
  fListResult.Free;
  fListParams.Free;
  DeleteCriticalSection(fCS);
  inherited;
end;




function TComPort.OpenPort:HResult;
begin
 result:=s_ok;
 ClosePort;
 ResetPort;
 fTCPServer.Active:=true;
 {hComm:=CreateFile(PCHAR(fPort),
                      GENERIC_READ or  GENERIC_WRITE,
                      0,
                      nil,
                      OPEN_EXISTING,
                      FILE_ATTRIBUTE_NORMAL,// or FILE_FLAG_OVERLAPPED,
                      0);
  result:=GetLastError;
  PortIni(fDelayRead);}

end;



procedure TComPort.PortIni(DelayRead: integer);
var
CommDCB:TDCB;
DTime:TCommTimeouts;
begin
 if (hComm<=0) or (hComm=Invalid_Handle_Value) then
  begin
   sleep(100);
   exit;
  end;


 GetCommState(hComm,CommDCB);
// if fOnRts then
//  CommDCB.Flags:=$3004
// else
  CommDCB.Flags:=$1011;

 CommDCB.Parity:=fPARITY;
 CommDCB.BaudRate:=fBaud;
 CommDCB.ByteSize:=fByte;
 CommDCB.StopBits:=fStopBits;
 SetCommState(hComm,CommDCB);
 GetCommTimeouts(hComm,DTime);
 DTime.ReadIntervalTimeout:=100;
 DTime.ReadTotalTimeoutMultiplier:=0;
 DTime.ReadTotalTimeoutConstant:=DelayRead;
 DTime.WriteTotalTimeoutMultiplier:=0;
 DTime.WriteTotalTimeoutConstant:=500;
 SetCommTimeouts(hComm,DTime);
 SetupComm(hComm,90,90);
 SetCommMask(hComm,EV_TXEMPTY);

end;

procedure TComPort.ResetPort;
var ini:TIniFile;
begin
 ini:=TIniFile.Create(IniName);
 try
   fPort:=ini.ReadString('Port','Port','COM1');
   fBaud:=ini.ReadInteger('Port','Baud',19200);
   fByte:=ini.ReadInteger('Port','Byte',8);
   fParity:=ini.ReadInteger('Port','Parity',0);
   fStopBits:=ini.ReadInteger('Port','StopBits',2);
   fDelayRead:=ini.ReadInteger('Port','TimeOut',2000);
   fOnRts:=ini.ReadBool('Port','OnRts',false);


   fTCPServer.DefaultPort:=ini.ReadInteger('TCP','Port',33002);
 finally
  ini.free;
 end;

end;



function TComPort.Write(ppDriverData: pDriverData): HResult;
var  i,j:integer;
     pw,pwc:TBuff;
     crc:word;
     StrCommand,sss:string;
     th:TIdPeerThread;
     L:TList;
     Addr:dword;
     ac:TAddrConv;
     pCR:PConnectionRec;
     size:dword;
     flExists:boolean;
     pdd:PDriverData;
begin
  result:=s_ok;
  sleep(2000);
  StrCommand:=ppDriverData^.szNoCommand;
  if pos('_',StrCommand)<>0 then
   begin
    SetParams(ppDriverData);
    CreateNullResult(ppDriverData);
    exit;
   end;

 StrAddrToDword(ppDriverData^.szAddress,Addr);

 fillchar(pw,sizeof(pw),0);

 flExists:=false;

 L:=fTCPServer.Threads.LockList;
 EnterCriticalSection(fCS);
 try
 try
  for i:=0 to L.Count-1 do
   if TIdPeerThread(l[i]).Data<>nil then
     if PConnectionRec(pointer(TIdPeerThread(l[i]).Data)).Addr=Addr then // (Addr and $FFFFFF00) then
      begin
       flExists:=true;
       th:=TIdPeerThread(l[i]);
       pCR:=PConnectionRec(pointer(TIdPeerThread(l[i]).Data));
       if pCR^.IsWork then
        result:=s_false
       else
        begin
         ac.wAddr:=Addr;
         pw[0]:=$55;
         pw[1]:=ppDriverData^.dwDataSize;
         pw[2]:=0;
         for j:=0 to High(ac.bAddr) do
          pw[3+j]:=ac.bAddr[j];
         pw[7]:=strtoint(ppDriverData^.szNoCommand);
         for j:=0 to ppDriverData^.dwDataSize-1 do
          pw[8+j]:=ppDriverData^.pData[j];
         j:=ppDriverData^.dwDataSize+8;
         pw[j]:=random(255);
         pw[j+1]:=HiByte(pCR^.Sign);
         pw[j+2]:=LoByte(pCR^.Sign);
         crc:=CalcCRC(pw,7,j+2);
         pw[j+3]:=hiByte(crc);
         pw[j+4]:=loByte(crc);
         pCR^.CurrHandle:=ppDriverData^.Handle;
         pCR^.CurrCommand:=pw[7];

         EncryptPaket(pw,Key16ToString(pCR^.Key16),pwc,size);
         pCR^.BuffW:=pwc;
         pCR^.BuffSize:=size;
         pCR^.IsWork:=true;
        end;
      end;

 except
  on e:exception do
   begin
    sss:=e.Message;
    sleep(10);
   end;
 end;
 finally
  LeaveCriticalSection(fCS);
  fTCPServer.Threads.UnlockList;
  if not flExists then
   begin
     pdd:=coTaskMemAlloc(sizeof(DriverData));
     pdd^.Handle:=ppDriverData^.Handle;
     pdd^.szAddress:=nil;
     pdd^.szNoCommand:=nil;//stringtolpolestr(ppDriverData^.szNoCommand);
     pdd^.Result:=2;
     pdd^.pData:=nil;
     pdd^.dwDataSize:=0;
     fListResult.Add(pdd);
   end;
 end;



end;

function TComPort.Read(out ppDriverData:pDriverData): HResult;
begin
 ppDriverData:=nil;
 result:=s_false;
 with fListResult.LockList do
  try
    if Count=0 then exit;
    ppDriverData:=Items[0];
    Delete(0);
    result:=s_ok;
  finally
   fListResult.UnlockList;
  end;
end;

procedure TComPort.Onconnect(AThread: TIdPeerThread);
var pCR:PConnectionRec;
begin
 //AThread.FreeOnTerminate:=true;
 EnterCriticalSection(fCS);
 new(pCR);
 pCR^.IsWork:=false;
 pCR^.BuffSize:=0;

 Athread.Data:=TObject(pCR);
 ExecCommand2(AThRead);
 LeaveCriticalSection(fCS);
end;

procedure TComPort.OnDisconnect(AThread: TIdPeerThread);
var pCR:PConnectionRec;
    pdd:pDriverData;
begin
 if AThread=nil then exit;
 EnterCriticalSection(fCS);
 if AThread.Data<>nil then
  begin
    pCR:=PConnectionRec(pointer(AThread.Data));
    if pCR^.IsWork then
     begin
       pdd:=coTaskMemAlloc(sizeof(DriverData));
       pdd^.Handle:=pCR^.CurrHandle;
       pdd^.szAddress:=nil;
       pdd^.szNoCommand:=nil;
       pdd^.Result:=2;
       pdd^.pData:=nil;
       pdd^.dwDataSize:=0;
       fListResult.Add(pdd);
     end;
     dispose(pointer(AThread.Data));
     AThread.Data:=nil;
  end;
 LeaveCriticalSection(fCS);

 fTCPServer.ThreadMgr.ReleaseThread(AThread);

end;

procedure TComPort.OnExecute(AThread: TIdPeerThread);
var br:TBuff;
    j:integer;
    b:byte;
    fi,size:dword;
    pCR:PConnectionRec;
begin
 sleep(1);
 if AThread.Data=nil then exit;
 if Athread.Terminated then exit;
 if not AThread.Connection.Connected then exit;

 EnterCriticalSection(fCS);
 try
 pCR:=PConnectionRec(pointer(AThread.Data));
   if pCR^.IsWork and (pCR^.BuffSize=0) then
   if (GetTickCount-pCR^.TimeWrite)>=fTimeOutRead then
     begin
      AThread.Connection.Disconnect;
      exit;
     end;

    if pCR^.IsWork and (pCR^.BuffSize>0) then
     begin
      AThread.Connection.WriteBuffer(pCR^.BuffW,pCR^.BuffSize);
      pCR^.TimeWrite:=GetTickCount;
      SetCountBytes(true,pCR^.BuffSize,pCR^.Addr);
      pCR^.BuffSize:=0;
     end;

  AThread.Connection.ReadTimeout:=50;
  j:=0;
  FillChar(br,sizeof(TBuff),0);
  while True do
   try
    AThread.Connection.ReadBuffer(b,1);
    br[j]:=b;
    inc(j);

   except
     fi:=0;

     while CheckPaket(br,fi,size) do
      begin
       SetCountBytes(false,size,pCR^.Addr);
       if ((br[fi+2] and 1)=1) then
        if (((br[fi+2] shr 2) and 1)=1) then
         ExecIntCommand(AThread,br,fi,size)
        else
         ExecExtCommand(AThread,br,fi,size);

       inc(fi);
      end;

    break;
   end;
finally
 LeaveCriticalSection(fCS);
end;

end;

procedure TComPort.ClearObj;
var i:integer;
    pdd:pDriverData;
begin
 for i:=0 to fListParams.Count-1 do
  dispose(fListParams[i]);
 fListParams.Clear;
 with fListResult.LockList do
  try
   for i:=0 to Count-1 do
    begin
     pdd:=Items[i];
     if pdd^.szAddress<>nil then
      coTaskMemFree(pdd^.szAddress);
     if pdd^.szNoCommand<>nil then
      coTaskMemFree(pdd^.szNoCommand);
     if pdd^.pData<>nil then
      coTaskMemFree(pdd^.pData);
     coTaskMemFree(pdd);
    end;
  finally
   fListResult.UnlockList;
  end;
end;

procedure TComPort.SetParams(ppDriverData: pDriverData);
var i:integer;
    p:pParamRec;

begin
 if ppDriverData.dwDataSize<>16 then exit;
 new(p);
 for i:=0 to ppDriverData.dwDataSize-1 do
   p^.Key16[i]:=ppDriverData^.pData[i];
 if StrAddrToDword(ppDriverData^.szAddress,p^.Addr) then
  fListParams.Add(p)
 else
  dispose(p);

end;

procedure TComPort.ExecCommand2(AThread: TIdPeerThread);
var bw:TBuff;
    crc:word;
    pCR:PConnectionRec;
begin
 pCR:=PConnectionRec(pointer(AThread.Data));
 if pCR=nil then exit;
 fillchar(bw,sizeof(TBuff),0);
 bw[0]:=$55;
 bw[1]:=0;
 bw[2]:=$4;
 bw[7]:=2;
 bw[8]:=0;
 bw[9]:=0;
 bw[10]:=0;
 crc:=CalcCrc(bw,0,10);
 bw[11]:=hiByte(crc);
 bw[12]:=loByte(crc);
 AThread.Connection.WriteBuffer(bw,13);
 
end;

function TComPort.CheckPaket(Arr: TBuff; var FirstIndex: dword;
  out Len: dword): boolean;
var crc:word;
    hi,lo,i,j,cbl:integer;
begin
 result:=false;

 while not result do
  begin
   Len:=0;
   if FirstIndex>High(Arr) then exit;
   j:=-1;
   for i:=FirstIndex to High(Arr) do
    if Arr[i]=$55 then
     begin
      j:=i;
      break;
     end;
   if j=-1 then break;
   if BitStat(Arr[j+2],2)=1 then
    begin
     hi:=j+11+Arr[j+1];
     lo:=hi+1;
     crc:=makeword(Arr[lo],Arr[hi]);
     result:=crc=CalcCRC(Arr,j,hi-1);
     FirstIndex:=j;
     len:=11+Arr[j+1]+2;
     if not result then
      FirstIndex:=FirstIndex+1;
    end
   else
    begin
    // вычисляем кол-во блоков по 16 байт криптованного пакета
       cbl:=((Arr[j+1]+6) div 16);
       if ((Arr[j+1]+6) mod 16)>0 then
        cbl:=cbl+1;


       hi:=j+7+(cbl*16);
       lo:=j+7+(cbl*16)+1;
       crc:=makeword(Arr[lo],Arr[hi]);
       result:=crc=CalcCRC(Arr,j,hi-1);
       FirstIndex:=j;
       Len:=7+(cbl*16)+2;
       if not result then
        FirstIndex:=FirstIndex+1;
    end;
  end;

end;

procedure TComPort.ExecExtCommand(AThread: TIdPeerThread; B: TBuff; FI,
  Size: dword);
var br:TBuff;
    i:integer;
    key16:string;
    sizeo:dword;
    crc,sign:word;
    ac:TAddrConv;
    pCR:PConnectionRec;
    pDD:PDriverData;
begin
 if size=0 then exit;
 if AThread=nil then exit;
 if AThread.Data=nil then exit;
 pCR:=pointer(AThread.Data);

 for i:=0 to High(ac.bAddr) do
  ac.bAddr[i]:=b[fi+3+i];
 if pCR^.Addr<>ac.wAddr then exit;

 Fillchar(br,sizeof(br),0);

 Key16:=Key16ToString(pCR^.Key16);
 DecryptPaket(B,FI,Size,Key16,br,sizeo);
 if sizeo=0 then exit;

 sign:=makeword(br[sizeo-3],br[sizeo-4]);
 //if pCR^.Sign<>Sign then exit;

 crc:=makeword(br[sizeo-1],br[sizeo-2]);
 if calccrc(br,7,sizeo-3)<>crc then exit;
 if (pCR^.CurrCommand<>br[7]) and ((br[2] and $2)=$0) then exit;

 pdd:=coTaskMemAlloc(sizeof(DriverData));
 if (br[2] and $2)=$2 then
  begin
   pdd^.Handle:=0;
   pdd^.szAddress:=StringToLPOleStr(DWordToStrAddr(pCR^.Addr));
   pdd^.szNoCommand:=stringtolpolestr(inttostr(br[7]));
  end
 else
  begin
   pdd^.Handle:=pCR^.CurrHandle;
   pdd^.szAddress:=nil;
   pdd^.szNoCommand:=nil;
  end;

 pdd^.Result:=s_ok;
 pdd^.pData:=nil;
 pdd^.dwDataSize:=br[1];
 pdd^.pData:=coTaskMemAlloc(pdd^.dwDataSize);
 for i:=0 to pdd^.dwDataSize-1 do
  pdd^.pData[i]:=br[8+i];


 pCR^.IsWork:=false;
 pCR^.CurrHandle:=0;
 pCR^.CurrCommand:=0;

 fListResult.Add(pdd);


end;

