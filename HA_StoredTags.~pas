procedure THAStoredTags.Execute;
var i:integer;
begin
 repeat
  sleep(1);
  if fFillHashList then
   begin
    FillHashList;
    fFillHashList:=false;
   end;

  CheckAddedTags;
  i:=0;
  while (i<10) and (not Terminated) do
   begin
     if fFillHashList then break;
     sleep(200);
     inc(i);
   end;


 until Terminated;
end;

procedure THAStoredTags.FillHashList;
var pHR:PHAHashRec;
    HR:THAHashRec;
    i:int64;
    fl:boolean;
begin
 if fST=nil then exit;
 fCurrentRecordIsFill:=1;
 i:=Length(DescriptionStoredTags)+4;
 fl:=false;
 while i>=0 do
  begin
   HR:=GetHashRec(i);
   inc(fCurrentRecordIsFill);
   if i<0 then break;
   if (HR.Flags and ST_Deleted)<>ST_Deleted then
    begin
     fl:=true;
     new(pHR);
     fillchar(pHR^,sizeof(THAHashRec),0);
     pHR^.Hash:=HR.Hash;
     pHR^.Flags:=HR.Flags;
     pHR^.Position:=HR.Position;
     fHashList.Add(pHR);
   end;  
  end;
 if fl then
  fHashList.Sort(@SortHash);
end;

