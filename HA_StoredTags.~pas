function MakeHash(const s: string): Longint;
{small hash maker}
var
  I: Integer;
begin
  Result := 0;
  for I := 1 to Length(s) do
    Result := ((Result shl 7) or (Result shr 25)) + Ord(s[I]);
end;


function SortHash(Item1, Item2: Pointer): Integer;
var p1,p2:PHAHashRec;
begin

 p1:=Item1; p2:=Item2;
 if p1^.Hash<p2^.Hash then
  result:=-1
 else
  if p1^.Hash>p2^.Hash then
   result:=1
  else
   result:=0;  
end;



