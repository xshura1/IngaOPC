function THAStoredTags.SetRecord(FirstPosition: Int64;
  TagName: string; Value: OleVariant;
  Quality: word; TimeStamp: TFileTime):Int64;


procedure SetSimpleValue(TypeTag:word; V:OleVariant);
var cr:THAConvertRec;
begin
 fillchar(cr.asArrayByte,sizeof(cr.asArrayByte),0);
 case TypeTag of
  vt_i2   : cr.asvt_i2:=V;
  vt_i4   : cr.asvt_i4:=V;
  vt_r4   : cr.asvt_r4:=V;
  vt_r8   : cr.asvt_r8:=V;
  vt_cy   : cr.asvt_cy:=V;
  vt_date : cr.asvt_date:=V;
  vt_bool : cr.asvt_bool:=V;
  vt_i1   : cr.asvt_i1:=V;
  vt_ui1  : cr.asvt_ui1:=V;
  vt_ui2  : cr.asvt_ui2:=V;
  vt_ui4  : cr.asvt_ui4:=V;
 end;
 fST.Write(cr.asArrayByte,8);
end;

procedure SetStrValue(V:OleVariant);
var Len:dword;
    s:string;
    i:integer;
begin
 s:=VarToStr(v);
 Len:=Length(s);
 fST.Write(Len,sizeof(Len));
 for i:=1 to Len do
  fST.Write(s[i],1);
end;




var LenRecord,LenTagName,LenArray:dword;
    TypeTag:word;
    HashTagName:LongInt;
    Flags: byte;
    i:integer;
begin
 fST.Position:=FirstPosition;
 LenRecord:=FirstPosition;
 Flags:=0;

 fST.Write(LenRecord,sizeof(LenRecord));
 fST.Write(Flags,sizeof(Flags));

 HashTagName:=MakeHash(TagName);
 fST.Write(HashTagName,sizeof(HashTagName));

 LenTagName:=Length(TagName);
 fST.Write(LenTagName,sizeof(LenTagName));

 for i:=1 to LenTagName do
  fST.Write(TagName[i],1);

 TypeTag:=VarType(Value);
 fST.Write(TypeTag,sizeof(TypeTag));

 if (TypeTag and vt_array)=vt_array then
  LenArray:=VarArrayHighBound(Value,1)+1
 else
  LenArray:=0;

 fST.Write(LenArray,sizeof(LenArray));

 if (TypeTag and vt_array)=vt_array then
  begin
   for i:=0 to LenArray-1 do
    if (TypeTag and VarTypeMask)=vt_bstr then
     SetStrValue(Value[i])
    else
     SetSimpleValue((TypeTag and VarTypeMask),Value[i]);
  end
 else
  if TypeTag=vt_bstr then
   begin
    SetStrValue(Value);
   end
  else
   SetSimpleValue(TypeTag,Value);

 fST.Write(Quality,sizeof(Quality));
 fST.Write(TimeStamp.dwLowDateTime,sizeof(TimeStamp.dwLowDateTime));
 fST.Write(TimeStamp.dwHighDateTime,sizeof(TimeStamp.dwHighDateTime));

 result:=fST.Position;
 LenRecord:=fST.Position-FirstPosition;
 fST.Position:=FirstPosition;
 fST.Write(LenRecord,sizeof(LenRecord));

end;

function THAStoredTags.SetStoredFile(FileName: string): HResult;
var s:string;
    c:char;
    i:integer;
    v:word;
    minLen:integer;
begin
 fErrorString:='';
 result:=s_ok;

 CheckAddedTags;
 ClearHashList;
 ClearAddedTagsList;
 if fST<>nil then
  fST.Free;
 minLen:=Length(DescriptionStoredTags)+4;
 fFileName:=FileName;
 if fFileName='' then exit;
 try
  if FileExists(fFileName) then
   begin

     fST:=TFileStream.Create(fFileName,fmOpenReadWrite);
     if fST.Size<minLen then
      begin
       fErrorString:='Неверный формат файла '+fFileName;
       result:=s_false;
       fST.Free;
       fST:=nil;
       exit;
      end;

     fST.Position:=0;
     s:='';
     for i:=1 to (minLen-4) do
      begin
       fST.Read(c,1);
       s:=s+c;
      end;

     if CompareText(DescriptionStoredTags,s)<>0 then
      begin
       fErrorString:='Неверный формат файла '+fFileName;
       result:=s_false;
       fST.Free;
       fST:=nil;
       exit;
      end;
     fST.Position:=fST.Position+4;

     {fST.Read(v,sizeof(word));

     if v<>VersionSTV then
      begin
       fErrorString:='Неверная версия файла '+fFileName;
       result:=s_false;
       fST.Free;
       fST:=nil;
       exit;
      end;
      }

   end
  else
   begin
    fST:=TFileStream.Create(fFileName,fmCreate);
    fST.Position:=0;
    s:=DescriptionStoredTags;

    for i:=1 to minlen-4 do
      fST.Write(s[i],1);


    v:=VersionSTV;
    fST.Write(v,sizeof(word));
    fST.Write(v,sizeof(word));
   end;

 fFillHashList:=true;

 except
  on E:Exception do
   begin
    fErrorString:=E.Message;
    result:=s_false;
    fST:=nil;
   end;
 end;

end;

