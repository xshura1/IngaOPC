procedure THAStoredTags.CheckAddedTags;

function UpdateRecord(StoredValue,Value:OleVariant):boolean;
var STT,TT:word;
begin
 STT:=VarType(StoredValue);
 TT:=VarType(Value);
 result:= ((STT in [vt_i1,vt_ui1, vt_i2, vt_ui2, vt_i4, vt_ui4, vt_r4, vt_r8, vt_cy, vt_date,vt_bool]) and
           (TT  in [vt_i1,vt_ui1, vt_i2, vt_ui2, vt_i4, vt_ui4, vt_r4, vt_r8, vt_cy, vt_date,vt_bool]));

 if result then exit;
 if (STT=vt_bstr) or (TT=vt_bstr) then
  begin
   result:=false;
   exit;
  end;

 if ((STT and vt_array)=vt_array) and ((TT and vt_array)=vt_array) then
  begin
   result:= ((STT and VarTypeMask in [vt_i1,vt_ui1, vt_i2, vt_ui2, vt_i4, vt_ui4, vt_r4, vt_r8, vt_cy, vt_date,vt_bool]) and
             (TT and VarTypeMask  in [vt_i1,vt_ui1, vt_i2, vt_ui2, vt_i4, vt_ui4, vt_r4, vt_r8, vt_cy, vt_date,vt_bool])) and
             (VarArrayHighBound(StoredValue,1)=VarArrayHighBound(Value,1));

  end;

{
 if ((StoredTypeTag and vt_array)=vt_array) and ((TypeTag and vt_array)=vt_array) then
  begin

   if ((StoredTypeTag and VarTypeMask)=vt_bstr) or ((TypeTag and VarTypeMask)=vt_bstr) then
    begin
     result:=false;
   //  exit;
    end
   else
    begin

    end;


  end;
 }



end;

procedure AddNewRecord(TagName:string; Value:OleVariant; Quality:word; TimeStamp:TFileTime);
var FP:Int64;
    pH:PHAHashRec;
begin
  FP:=fST.Size;
  SetRecord(FP,TagName,Value,Quality,TimeStamp);
  new(pH);
  pH.Hash:=MakeHash(TagName);
  pH^.Flags:=0;
  pH^.Position:=FP;
  fHashList.Add(pH);
  fHashList.Sort(@SortHash);
end;


var IndHashList:integer;
    p:PHAStoredRec;
    SR:THAStoredRec;
    FirstPosition:Int64;

begin
 if fST=nil then exit;
 while fAddedTagsList.Count>0 do
  begin
   p:=fAddedTagsList[0];
   if GetStoredRecByTagName(p^.TagName, SR,FirstPosition,IndHashList) then
    begin
     // узнаем, сможем ли мы записать данный тэг в то же самое место...
     // вдруг тип тэга изменился, или тип тэга массив или строка - тогда
     // нужно добавлять новую запись, а старую помечать как удаленную

     if UpdateRecord(SR.Value,p^.Value) then
       SetRecord(FirstPosition,p^.TagName,p^.Value,p^.Quality,p^.TimeStamp)
     else
      begin
        SetFlags(FirstPosition,ST_Deleted);
        dispose(fHashList[IndHashList]);
        fHashList.Delete(IndHashList);
        AddNewRecord(p^.TagName,p^.Value,p^.Quality,p^.TimeStamp);
      end;
    end
   else
    AddNewRecord(p^.TagName,p^.Value,p^.Quality,p^.TimeStamp);

   VarClear(p^.Value);
   dispose(p);
   fAddedTagsList.Delete(0);
  end;
end;

procedure THAStoredTags.ClearAddedTagsList;
var i:integer;
begin
 for i:=0 to fAddedTagsList.Count-1 do
  begin
   VarClear(THAStoredRec(fAddedTagsList[i]^).Value);
   dispose(fAddedTagsList[i]);
  end;
 fAddedTagsList.Clear; 
end;

procedure THAStoredTags.ClearHashList;
var i:integer;
begin
  for i:=0 to fHashList.Count-1 do
   dispose(fHashList[i]);
  fHashList.Clear;

end;

