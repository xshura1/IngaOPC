function THAStoredTags.GetStoredRecByTagName(const TagName: string;
  var SR: THAStoredRec; out FirstPosition:Int64; out IndexHashList:integer): boolean;
var Hash:LongInt;
    FI,EI,i,j:integer;
    ind,ind1:Int64;

    s:string;
begin
 result:=false;
 Hash:=MakeHash(TagName);
 FI:=0; EI:=fHashList.Count-1;
 SearchHash(Hash,FI,EI,j);
 if j<0 then exit;

 FI:=j;
 for i:=FI downto 0 do
  if THAHashRec(fHashList[i]^).Hash=Hash then
   j:=i
  else
   break;


 for i:=j to fHashList.Count-1 do
  if THAHashRec(fHashList[i]^).Hash=Hash then
    begin
     if (THAHashRec(fHashList[i]^).Flags and ST_Deleted)<>ST_Deleted then
      begin
       ind:=THAHashRec(fHashList[i]^).Position;
       s:=GetTagName(ind);
       if CompareStr(s,TagName)=0 then
        begin
         IndexHashList:=i;
         result:=true;
         break;
        end;
      end;
    end
  else
   Break;

 if not result then exit;
 ind1:=ind;
 SR:=GetStoredRec(Ind);
 result:=(Ind>=0);
 FirstPosition:=ind1;
end;

function THAStoredTags.GetTagName(FirstPosition: Int64): string;
var Len,i:dword;
    c:char;
begin
 Len:=GetLenTagName(FirstPosition);
 SetLength(result,Len);
 fST.Position:=FirstPosition+13;
 Len:=fST.Position+Len;
 i:=1;
 while fST.Position<Len do
  begin
   fST.Read(c,1);
   result[i]:=c;
   inc(i);
  end;

end;
 
function THAStoredTags.GetTimeStamp(FirstPosition: Int64): TFileTime;
var d:dword;
begin
 d:=GetLenRecord(FirstPosition)-8;
 fST.Position:=FirstPosition+d;
 fST.Read(result.dwLowDateTime,sizeof(result.dwLowDateTime));
 fST.Read(result.dwHighDateTime,sizeof(result.dwHighDateTime));
end;

function THAStoredTags.GetTypeTag(FirstPosition: Int64): word;
var Len:dword;
begin
 fST.Position:=FirstPosition+9;
 fST.Read(Len,sizeof(Len));
 fST.Position:=FirstPosition+13+Len;
 fST.Read(result,sizeof(result));
end;

function THAStoredTags.GetValue(FirstPosition: Int64): OleVariant;

function GetSimpleValue(TypeTag:word):OleVariant;
var cr:THAConvertRec;
    Len:dword;
    i:integer;
begin
 fillchar(cr.asArrayByte,sizeof(cr.asArrayByte),0);
 Len:=fST.Position+8;
 i:=0;
 while fST.Position<Len do
  begin
   fST.Read(cr.asArrayByte[i],1);
   inc(i);
  end;

 case TypeTag of
    vt_i2   : result:=VarAsType(cr.asvt_i2,TypeTag);
    vt_i4   : result:=VarAsType(cr.asvt_i4,TypeTag);
    vt_r4   : result:=VarAsType(cr.asvt_r4,TypeTag);
    vt_r8   : result:=VarAsType(cr.asvt_r8,TypeTag);
    vt_cy   : result:=VarAsType(cr.asvt_cy,TypeTag);
    vt_date : result:=VarAsType(cr.asvt_date,TypeTag);
    vt_bool : result:=VarAsType(cr.asvt_bool,TypeTag);
    vt_i1   : result:=VarAsType(cr.asvt_i1,TypeTag);
    vt_ui1  : result:=VarAsType(cr.asvt_ui1,TypeTag);
    vt_ui2  : result:=VarAsType(cr.asvt_ui2,TypeTag);
    vt_ui4  : result:=VarAsType(cr.asvt_ui4,TypeTag);
  end;
end;

function GetStrValue:string;
var Len:dword;
    c:char;
    i:integer;
begin
 fST.Read(Len,sizeof(len));
 SetLength(result,Len);
 Len:=fST.Position+Len;
 i:=1;
 while fST.Position<Len do
  begin
   fST.Read(c,1);
   result[i]:=c;
   inc(i);
  end;
end;


var TypeTag:word;
    LenTagName,LenArray:dword;
    i:integer;
begin
 result:=VarEmpty;
 TypeTag:=GetTypeTag(FirstPosition);
 LenTagName:=GetLenTagName(FirstPosition);
 fST.Position:=FirstPosition+15+LenTagName;
 fST.Read(LenArray,sizeof(LenArray));

 if (TypeTag and vt_array)=vt_array then
  begin
   result:=VarArrayCreate([0,LenArray-1], TypeTag and VarTypeMask);

   for i:=0 to LenArray-1 do
    if (TypeTag and VarTypeMask)=vt_bstr then
      result[i]:=GetStrValue
    else
      result[i]:=GetSimpleValue(TypeTag and VarTypeMask);
  end
 else
  if TypeTag=vt_bstr then
   begin
    result:=GetStrValue;
   end
  else
   begin
     result:=GetSimpleValue(TypeTag);
   end;  
end;

procedure THAStoredTags.SearchHash(Hash: Integer; var FI, EI: integer; var Ind:integer);
var i:integer;
begin
 Ind:=-1;

 if EI-FI<3 then
  begin
   for i:=FI to EI do
    if THAHashRec(fHashList[i]^).Hash=Hash then
     begin
      Ind:=i;
      break;
     end;
  end
 else
  begin
   i:=FI+((EI-FI) div 2);
   if THAHashRec(fHashList[i]^).Hash<Hash then
    SearchHash(Hash,i,EI,Ind)
   else
    if THAHashRec(fHashList[i]^).Hash>Hash then
     SearchHash(Hash,FI,i,Ind)
    else
     Ind:=i;
  end;

{ if Ind<0 then exit;
 j:=Ind;
 for i:=j downto 0 do
  if THAHashRec(fHashList[i]^).Hash=Hash then
   Ind:=i
  else
   break;   }
end;

