function CopyFile( InFile,OutFile: String): Longint;
var  InFS,OutFS: TFileStream;
begin
 InFS  := TFileStream.Create( InFile,  fmOpenRead );
 OutFS := TFileStream.Create( OutFile, fmCreate   );
 try
  InFS.Position:=0;
  Result := OutFS.CopyFrom( InFS, InFs.Size);
 finally
  InFS.Free;
  OutFS.Free;
 end;
end;


