function TfmWizard.CreatePrj(FolderName: string):boolean;
var fs:TStringList;
    TemplDir,NamePrj,sbuff:string;
    b:byte;
    i:integer;
begin
 result:=true;
 if not DirectoryExists(FolderName) then
  result:=CreateDir(FolderName);
 if not result then exit;
 NamePrj:='';
 for i:=length(FolderName) downto 1 do
  if FolderName[i]<>'\' then
   NamePrj:=FolderName[i]+NamePrj
  else
   break;
 result:=NamePrj<>'';
 if not result then exit;

 TemplDir:=ExtractFileDir(ParamStr(0));
 TemplDir:=TemplDir+'\Templates';
 sbuff:='library '+NamePrj+';';

 fs:=TStringList.Create;
 try
  fs.LoadFromFile(TemplDir+'\PrjTemplate.dpr');
  fs.Insert(0,sbuff);
  fs.SaveToFile(FolderName+'\'+NamePrj+'.dpr');
 finally
  fs.Free;
 end;
 copyfile(TemplDir+'\UDialog.dfm',FolderName+'\UDialog.dfm');
 copyfile(TemplDir+'\UDialog.pas',FolderName+'\UDialog.pas');
 copyfile(TemplDir+'\Intf.pas',FolderName+'\Intf.pas');
 copyfile(TemplDir+'\Main.pas',FolderName+'\Main.pas');
end;

