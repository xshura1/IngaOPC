procedure &lt;Дата и время/&gt;OnWrite(Tags:THATags);
 var ss,s,m,h,d,mo,y:word;
begin
 try
 [&quot;Command_7&quot;].count:=7;
 DecodeDate([&quot;DateAndTime&quot;].vqt.value,y,mo,d);
 DecodeTime([&quot;DateAndTime&quot;].vqt.value,h,m,s,ss);
 [&quot;Command_7&quot;][0]:=s;
 [&quot;Command_7&quot;][1]:=m;
 [&quot;Command_7&quot;][2]:=h;
 [&quot;Command_7&quot;][3]:=d;
 [&quot;Command_7&quot;][4]:=mo;
 [&quot;Command_7&quot;][5]:=1;
 [&quot;Command_7&quot;][6]:=y-2000;
 [&quot;Command_7&quot;].Run;
 except
 end;
end;


procedure &lt;Эл. счетчик/&gt;OnWrite(Tags:THATags);
var w:word;
    dw:dword;
begin
 
 [&quot;Command_36&quot;].count:=5;
 [&quot;Command_36&quot;][0]:=12;
 dw:=[&quot;ChetEN&quot;].vqt.value;
 w:=word(dw);
 [&quot;Command_36&quot;][1]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][2]:=byte(w);
 
 w:=word(dw shr 16);
 [&quot;Command_36&quot;][3]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][4]:=byte(w);
 
 [&quot;Command_36&quot;].Run;
 [&quot;Команда 27 подавалась&quot;].newvalue:=false;

end;

procedure &lt;Command_25/&gt;OnAfterRead(Tags:THATags; Command:THACommand; DriverData:THADriverData);
var b:byte;
begin
 SetOtvResult(DriverData.result);
 if not [&quot;Команда 27 подавалась&quot;].oldvalue then
  begin
   [&quot;Command_27&quot;].count:=1;
   [&quot;Command_27&quot;].Run;
  end;
  
 if DriverData.result=0 then
  begin
   
   b:=DriverData[0];
   [&quot;Состояние&quot;].newvalue:=b;
   [&quot;Охрана внеш.&quot;].newvalue:=(b shr 2) and $3;
   [&quot;Охрана внут.&quot;].newvalue:=b and $3;
   if ((b shr 4) and $F)&lt;&gt;0 then
    begin
     [&quot;Command_27&quot;].count:=1;
     [&quot;Command_27&quot;].Run;
     if ((b shr 4) and $1)=1 then
      begin
       [&quot;Command_20&quot;].count:=1;
       [&quot;Command_20&quot;][0]:=255;
       [&quot;Command_20&quot;].Run;
      end;
    end;
  end
 else
  begin
   [&quot;Состояние&quot;].NewQuality:=opc_quality_bad;
  end;
end;

procedure &lt;Command_27/&gt;OnAfterRead(Tags:THATags; Command:THACommand; DriverData:THADriverData);
var b:byte;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   [&quot;Статистика\Кол-во принятых 27 команд&quot;].newvalue:=[&quot;Статистика\Кол-во принятых 27 команд&quot;].oldvalue+1;

   [&quot;Команда 27 подавалась&quot;].newvalue:=true;
   b:=DriverData[0];
   [&quot;TC\TC0&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC1&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC2&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC3&quot;].newvalue:=boolean(BitStat(b,3));
