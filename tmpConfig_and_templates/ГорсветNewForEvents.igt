<Header FileDescription="IngaOPC Template File" Version="0101" Script="
function BitStat (B1,B2:Word):boolean;
    begin
      if (B1 and (1 shl B2) &lt;&gt;0) then result:=true
      else result:=false;
    end;


procedure SetOtvResult(Res:dword);
var i:integer;
begin
 case Res of
  0:[&quot;Статистика\Кол-во ответов&quot;].newvalue:=[&quot;Статистика\Кол-во ответов&quot;].oldvalue+1;
  1:[&quot;Статистика\Кол-во не ответов&quot;].newvalue:=[&quot;Статистика\Кол-во не ответов&quot;].oldvalue+1;
  2:begin
     [&quot;Статистика\Кол-во не ответов от драйвера&quot;].newvalue:=[&quot;Статистика\Кол-во не ответов от драйвера&quot;].oldvalue+1;
     {if [&quot;Статистика\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Статистика\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Статистика\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end; }
    end; 
 end;   
 
 if Res&lt;&gt;0 then
  if [&quot;Статистика\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Статистика\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Статистика\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end;
 [&quot;Статистика\FlagOldResult&quot;].Newvalue:=Res;     
end;
 
procedure &lt;Состояние/&gt;OnRead(Tags:THATags);
var i:integer;
    fl:boolean;
begin
 fl:=false;
 [&quot;Команда 27 подавалась&quot;].newvalue:=false;
 
 for i:=0 to Tags.count-1 do
  if Tags[i].PropExists(5000) then
   begin
    fl:=true;
    break;
   end; 
 if fl then 
  begin  
   [&quot;Command_25&quot;].count:=1;
   [&quot;Command_25&quot;].Run;
  end
 else
  begin  
   [&quot;Command_27&quot;].count:=1;
   [&quot;Command_27&quot;].Run;
  end  

end;

