   [&quot;TIT\TIT5&quot;].newvalue:=DriverData[14];
   
   [&quot;Сост. ТУ&quot;].newvalue:=DriverData[15];
   
   b:=DriverData[3];
   [&quot;Охрана внеш.&quot;].newvalue:=(b shr 2) and $3;
   [&quot;Охрана внут.&quot;].newvalue:=b and $3;
  end
 else
  begin
  
 
   [&quot;TC\TC0&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC1&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC2&quot;].NewQuality:=opc_quality_bad;
