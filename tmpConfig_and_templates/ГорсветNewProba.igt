procedure &lt;Command_100/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var d,mo,y:word;
    str:string;
    sd:TDateTime;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   str:='Версия: '+inttostr(DriverData[0])+' Build: '+inttostr(DriverData[1]);
   d:=DriverData[2];
   mo:=DriverData[3];
   y:=DriverData[4]+2000;
   try
    sd:=EncodeDate(y,mo,d);
    str:=str+' Дата: '+DateToStr(sd);
    [&quot;Версия прошивки&quot;].newvalue:=str; 
   except
   [&quot;Версия прошивки&quot;].newquality:=opc_quality_bad; 
   end; 
  end
 else
  begin
   [&quot;Версия прошивки&quot;].NewQuality:=opc_quality_bad;
  end;   


end;

