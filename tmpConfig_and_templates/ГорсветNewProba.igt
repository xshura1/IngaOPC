<Header FileDescription="IngaOPC Template File" Version="0101" Checked="-1" Script="
function BitStat (B1,B2:Word):boolean;
    begin
      if (B1 and (1 shl B2) &lt;&gt;0) then result:=true
      else result:=false;
    end;


procedure SetOtvResult(Res:dword);
var i:integer;
begin
 case Res of
  0:[&quot;Statistics\Кол-во ответов&quot;].newvalue:=[&quot;Statistics\Кол-во ответов&quot;].oldvalue+1;
  1:[&quot;Statistics\Кол-во не ответов&quot;].newvalue:=[&quot;Statistics\Кол-во не ответов&quot;].oldvalue+1;
  2:begin
     [&quot;Statistics\Кол-во не ответов от драйвера&quot;].newvalue:=[&quot;Statistics\Кол-во не ответов от драйвера&quot;].oldvalue+1;
     {if [&quot;Статистика\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Статистика\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Статистика\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end; }
    end; 
 end;   
 
 if Res&lt;&gt;0 then
  if [&quot;Statistics\FlagOldResult&quot;].oldvalue&lt;&gt;Res then
      begin
       i:=[&quot;Statistics\Не ответы по времени&quot;].newValueAsArrayCount;
       [&quot;Statistics\Не ответы по времени&quot;].NewValueAsArray[i]:=now;       

      end;
 [&quot;Statistics\FlagOldResult&quot;].Newvalue:=Res;     
end;
 
procedure &lt;Состояние/&gt;OnRead(Device:TIGDevice; Tags:TIGTags);
var i:integer;
    fl:boolean;
begin
 fl:=false;
 [&quot;Команда 27 подавалась&quot;].newvalue:=false;
 
 for i:=0 to Tags.count-1 do
  if Tags[i].PropExists(5000) then
   begin
    fl:=true;
    break;
   end; 
 if fl then 
  begin  
   [&quot;Command_25&quot;].count:=1;
   [&quot;Command_25&quot;].run;
  end
 else
  begin  
   [&quot;Command_27&quot;].count:=1;
   [&quot;Command_27&quot;].run;
  end  

end;

procedure &lt;Дата и время/&gt;OnRead(Device:TIGDevice; Tags:TIGTags);
begin
 [&quot;Command_8&quot;].count:=1;
 [&quot;Command_8&quot;].run;
end;

procedure &lt;Дата и время/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
 var ss,s,m,h,d,mo,y:word;
begin
 try
 [&quot;Command_7&quot;].count:=7;
 DecodeDate([&quot;DateAndTime&quot;].vqt.value,y,mo,d);
 DecodeTime([&quot;DateAndTime&quot;].vqt.value,h,m,s,ss);
 [&quot;Command_7&quot;][0]:=s;
 [&quot;Command_7&quot;][1]:=m;
 [&quot;Command_7&quot;][2]:=h;
 [&quot;Command_7&quot;][3]:=d;
 [&quot;Command_7&quot;][4]:=mo;
 [&quot;Command_7&quot;][5]:=1;
 [&quot;Command_7&quot;][6]:=y-2000;
 [&quot;Command_7&quot;].run;
 except
 end;
end;


procedure &lt;Эл. счетчик/&gt;OnWrite(Device:TIGDevice; Tags:TIGTags);
var w:word;
    dw:dword;
begin
 
 [&quot;Command_36&quot;].count:=5;
 [&quot;Command_36&quot;][0]:=12;
 dw:=[&quot;ChetEN&quot;].vqt.value;
 w:=word(dw);
 [&quot;Command_36&quot;][1]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][2]:=byte(w);
 
 w:=word(dw shr 16);
 [&quot;Command_36&quot;][3]:=byte(w);
 w:=w shr 8;
 [&quot;Command_36&quot;][4]:=byte(w);
 
 [&quot;Command_36&quot;].run;
 [&quot;Команда 27 подавалась&quot;].newvalue:=false;

end;

procedure &lt;Command_25/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var b:byte;
begin
 SetOtvResult(DriverData.result);
 
  
 if DriverData.result=0 then
  begin
   [&quot;ShortSost&quot;].newvalue:=DriverData[0];

   b:=DriverData[0];
   [&quot;Состояние&quot;].newvalue:=b;
   [&quot;Охрана внеш.&quot;].newvalue:=(b shr 2) and $3;
   [&quot;Охрана внут.&quot;].newvalue:=b and $3;
   {if ((b shr 4) and $F)&lt;&gt;0 then
    begin
     [&quot;Command_27&quot;].count:=1;
     [&quot;Command_27&quot;].run;}
    { if ((b shr 4) and $1)=1 then
      begin
       [&quot;Command_20&quot;].count:=1;
       [&quot;Command_20&quot;][0]:=255;
       [&quot;Command_20&quot;].run;
      end;}
   // end;  
  end
 else
  begin
   //[&quot;Состояние&quot;].NewQuality:=opc_quality_bad;
   [&quot;ShortSost&quot;].NewQuality:=opc_quality_bad;
  end;
end;

procedure &lt;Command_27/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var b:byte;
    sost:dword;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   [&quot;Statistics\Кол-во принятых 27 команд&quot;].newvalue:=[&quot;Statistics\Кол-во принятых 27 команд&quot;].oldvalue+1;

   [&quot;Команда 27 подавалась&quot;].newvalue:=true;
   b:=DriverData[0];
   [&quot;TC\TC0&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC1&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC2&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC3&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC4&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC5&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC6&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC7&quot;].newvalue:=boolean(BitStat(b,7));
   b:=DriverData[1];
   [&quot;TC\TC8&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC9&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC10&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC11&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC12&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC13&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC14&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC15&quot;].newvalue:=boolean(BitStat(b,7));
   b:=DriverData[2];
   [&quot;TC\TC16&quot;].newvalue:=boolean(BitStat(b,0));
   [&quot;TC\TC17&quot;].newvalue:=boolean(BitStat(b,1));
   [&quot;TC\TC18&quot;].newvalue:=boolean(BitStat(b,2));
   [&quot;TC\TC19&quot;].newvalue:=boolean(BitStat(b,3));
   [&quot;TC\TC20&quot;].newvalue:=boolean(BitStat(b,4));
   [&quot;TC\TC21&quot;].newvalue:=boolean(BitStat(b,5));
   [&quot;TC\TC22&quot;].newvalue:=boolean(BitStat(b,6));
   [&quot;TC\TC23&quot;].newvalue:=boolean(BitStat(b,7));
   
   
   
   [&quot;ChetEN&quot;].newvalue:=MAKELONG(makeword(DriverData[5],DriverData[6]),
                                      makeword(DriverData[7],DriverData[8]));
   [&quot;TIT\TIT0&quot;].newvalue:=DriverData[9];
   [&quot;TIT\TIT1&quot;].newvalue:=DriverData[10];
   [&quot;TIT\TIT2&quot;].newvalue:=DriverData[11];
   [&quot;TIT\TIT3&quot;].newvalue:=DriverData[12];
   [&quot;TIT\TIT4&quot;].newvalue:=DriverData[13];
   [&quot;TIT\TIT5&quot;].newvalue:=DriverData[14];
   
  
   
   Case DriverData[15] and $3 of
    0:[&quot;Режим освещения&quot;].NewValue:=3;
    1:[&quot;Режим освещения&quot;].NewValue:=2;
    3:[&quot;Режим освещения&quot;].NewValue:=1;
   end; 
   
   
   b:=DriverData[3];
   [&quot;Охрана внеш.&quot;].newvalue:=(b shr 2) and $3;
   [&quot;Охрана внут.&quot;].newvalue:=b and $3;
   b:=(b shl 3) and $78;
   sost:=[&quot;Режим освещения&quot;].NewValue;
   
   if BitStat(DriverData[3],6) then
    begin
     
     [&quot;Заблокирован&quot;].NewValue:=false;

    end
   else
    begin
     Sost:=Sost or $200;
     [&quot;Заблокирован&quot;].NewValue:=true;
    end;    
   
   Sost:=Sost or b;
   
   b:=DriverData[2];
   if (b and $80)&lt;&gt;0 then
    Sost:=Sost or $40;
   
  // Sost:=Sost or $4;
    
   [&quot;ShortSost&quot;].newvalue:=Sost;
 
  end
 else
  begin
   
   [&quot;ShortSost&quot;].newvalue:=[&quot;ShortSost&quot;].oldvalue or 2147483648;
 
   [&quot;TC\TC0&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC1&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC2&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC3&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC4&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC5&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC6&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC7&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC8&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC9&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC10&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC11&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC12&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC13&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC14&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC15&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC16&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC17&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC18&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC19&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC20&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC21&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC22&quot;].NewQuality:=opc_quality_bad;
   [&quot;TC\TC23&quot;].NewQuality:=opc_quality_bad;
   
   [&quot;ChetEN&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT0&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT1&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT2&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT3&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT4&quot;].NewQuality:=opc_quality_bad;
   [&quot;TIT\TIT5&quot;].NewQuality:=opc_quality_bad;
   
   
   [&quot;Режим освещения&quot;].NewQuality:=opc_quality_bad;
   [&quot;Охрана внеш.&quot;].NewQuality:=opc_quality_bad;
   [&quot;Охрана внут.&quot;].NewQuality:=opc_quality_bad;
  end;              

end;
procedure &lt;Command_37/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
  
   [&quot;Timeauto&quot;].newvalue:=DriverData[0]*256+DriverData[1];
  end
 else
  begin
  
 
   [&quot;Timeauto&quot;].NewQuality:=opc_quality_bad;
  end; 
end;

procedure &lt;Command_8/&gt;OnAfterRead(Device:TIGDevice; Command:TIGCommand; DriverData:TIGDriverData);
var ss,s,m,h,d,mo,y:word;
    i:integer;
begin
 SetOtvResult(DriverData.result);
 if DriverData.result=0 then
  begin
   
   s:=DriverData[0];
   m:=DriverData[1];
   h:=DriverData[2];
   d:=DriverData[3];
   mo:=DriverData[4];
   y:=DriverData[6]+2000;
   try
    [&quot;DateAndTime&quot;].newvalue:=EncodeDate(y,mo,d);
    [&quot;DateAndTime&quot;].newvalue:=[&quot;DateAndTime&quot;].newvalue+EncodeTime(h,m,s,ss);
   except
    [&quot;DateAndTime&quot;].newquality:=OPC_QUALITY_BAD; 
   end; 
  end
 else begin
  
 
   [&quot;DateAndTime&quot;].NewQuality:=OPC_QUALITY_COMM_FAILURE;
   
  end;   

end;


