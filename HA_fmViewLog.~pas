procedure TfmViewLog.LoadLog;
var st:TStringList;
    p:PLogData;
    i,j,k:integer;
    N:PVirtualNode;
    s,slog:string;
begin
 st:=TStringList.Create;
 tv.BeginUpdate;
 try
  st.LoadFromFile(ChangeFileExt(ParamStr(0),'.log'));
  for i:=0 to st.Count-1 do
   begin
    N:=TV.AddChild(nil);
    p:=TV.GetNodeData(n);
    if p=nil then exit;
    s:='';
    k:=0;
    slog:=st[i];
    for j:=1 to Length(slog) do
     if (slog[j]=#09) or (j>=Length(slog)) then
      begin
       if (j>=Length(slog)) then
        s:=s+slog[j];
       case k of
        0:p^.Data:=s;
        1:p^.Obj:=s;
        2:p^.Func:=s;
        3:p^.ErrNo:=s;
        4:p^.DescrErr:=s;
       end;
       inc(k);
       s:='';
       if k>4 then k:=0; 
      end
     else
      s:=s+slog[j];
   end;
 finally
  st.Free;
