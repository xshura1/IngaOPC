                                                    @fQuality^,
                                                    @fTime^,
                                                    @fErrors^);

    AddLog(3,'IOPCAsyncIO2 Refresh2',ResR,ErrorCodeToString(ResR));
  end
 else
  begin
   resr:=THADAGroup(fGroup).DataCallBack.OnReadComplete(fIDTrans,
                                                   THADAGroup(fGroup).hClientGroup,
                                                   ResQ,
                                                   Res,
                                                   fCount,
                                                   @fClientHandle^,
                                                   @fValues^,
                                                   @fQuality^,
                                                   @fTime^,
                                                   @fErrors^);
   AddLog(3,'IOPCAsyncIO2 Read',ResR,ErrorCodeToString(ResR));
  end;
 ClearParams;


end;



procedure THATransaction.Sort;

function Sort_(Item1,Item2:pointer):integer;
var id1,id2:cardinal;
 begin
  if fDeviceTrans then
   begin
    id1:=THATransactionParam(Item1^).IDCache;
    id2:=THATransactionParam(Item2^).IDCache;
   end
  else
   begin
    id1:=THATransactionParam(Item1^).OPCItem.IDCache;
    id2:=THATransactionParam(Item2^).OPCItem.IDCache;
   end;

  if OPCMan.Controller[id1].OID<OPCMan.Controller[id2].OID then result:=1
   else
    if OPCMan.Controller[id1].OID>OPCMan.Controller[id2].OID then result:=-1
     else
       if Assigned(OPCMan.Tag[id1].ScriptW) and (not Assigned(OPCMan.Tag[id2].ScriptW)) then result:=1
       else
        if (not Assigned(OPCMan.Tag[id1].ScriptW)) and Assigned(OPCMan.Tag[id2].ScriptW) then result:=-1
        else
         if (not Assigned(OPCMan.Tag[id1].ScriptW)) and (not Assigned(OPCMan.Tag[id2].ScriptW)) then result:=0
         else
          if (OPCMan.Tag[id1].ScriptW.TypeScript=ts_OnWriteTag) and (OPCMan.Tag[id2].ScriptW.TypeScript<>ts_OnWriteTag) then result:=1
          else
           if (OPCMan.Tag[id1].ScriptW.TypeScript<>ts_OnWriteTag) and (OPCMan.Tag[id2].ScriptW.TypeScript=ts_OnWriteTag) then result:=-1
           else
            if (OPCMan.Tag[id1].ScriptW.TypeScript<>ts_OnWriteTag) and (OPCMan.Tag[id2].ScriptW.TypeScript<>ts_OnWriteTag) then result:=0
            else
             if OPCMan.Tag[id1].ScriptW.OID<OPCMan.Tag[id2].ScriptW.OID then result:=1
             else
              if OPCMan.Tag[id1].ScriptW.OID>OPCMan.Tag[id2].ScriptW.OID then result:=-1
              else
               result:=0;
 end;

begin
  fItems.Sort(@Sort_);
end;
}

