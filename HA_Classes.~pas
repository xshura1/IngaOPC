    fClientHandle :POPCHANDLEARRAY;
    fValues :POleVariantArray;
    fQuality:PWORDARRAY;
    fTime   :PTFileTimeARRAY;
    fErrors :PResultList;
    t:THAOPCItem;

procedure ClearParams;
var i:integer;
begin
 if fClientHandle<>nil then
  CoTaskMemFree(fClientHandle);
 if fQuality<>nil then
  CoTaskMemFree(fQuality);
 if fTime<>nil then
  CoTaskMemFree(fTime);
 if fValues<>nil then
  begin
    for i:=0 to fCount-1 do VarClear(fValues[i]);
    CoTaskMemFree(fValues);
  end;
 if fErrors<>nil then
  CoTaskMemFree(fErrors);
end;

begin
 if fDeviceTrans then exit;
// if THADAGroup(fGroup).Deleted then exit;
 if fItems.Count=0 then exit;
 if THADAGroup(fGroup).DataCallback=nil then exit;
// if not fDataChangeEnabled then exit;

 fClientHandle:=nil;
 fQuality:=nil;
 fTime:=nil;
 fValues:=nil;
 fErrors:=nil;

 fCount:=fItems.Count;

 fClientHandle:=OPCTaskMemAlloc(Res,sizeof(OPCHandle),fCount);
  if Res<>s_ok then
   begin
    ClearParams;
    Exit;
   end;



 fQuality:=OPCTaskMemAlloc(Res,sizeof(word),fCount);
  if Res<>s_ok then
   begin
    ClearParams;
    Exit;
   end;

 fTime:=OPCTaskMemAlloc(Res,sizeof(TFileTime),fCount);
  if Res<>s_ok then
   begin
    ClearParams;
    Exit;
   end;

 fValues:=OPCTaskMemAlloc(Res,sizeof(OleVariant),fCount);
  if Res<>s_ok then
   begin
    ClearParams;
    Exit;
   end;

 fErrors:=OPCTaskMemAlloc(Res,sizeof(HRESULT),fCount);
  if Res<>s_ok then
   begin
    ClearParams;
    Exit;
   end;

 ResQ:=s_ok;
 fCountErrors:=0;
 OPCMan.BeginRead;

 for i:=0 to fCount-1 do
  begin

   t:=THAOPCItem(THATransactionParam(fItems[i]^).OPCItem);
   fClientHandle[i]:=t.ClientHandle;
   if (t.AccessRight and OPC_READABLE)<>OPC_READABLE then
    begin
     fErrors[i]:=OPC_E_BADRIGHTS;
    // inc(fCountErrors);
     continue;
    end;

   fErrors[i]:=s_ok;

   if t.RequestedDatatype<>t.CanonicalDataType then
    begin
     fErrors[i]:=HAConvertVariantType(fValues[i],t.Value,THADAGroup(t.fGroup).LocaleID,t.RequestedDatatype);
     if fErrors[i]<>s_ok then
      begin
       res:=s_false;
  //     inc(fCountErrors);
      end;
    end
   else
    fValues[i]:=t.Value;

   fQuality[i]:=t.Quality;
   if t.Quality<>OPC_QUALITY_GOOD then
    resq:=s_false;
   fTime[i]:=t.TimeStamp;
  end;
 OPCMan.EndRead;

// if fCountErrors<fCount then
 if Refresh then
  begin
    resr:= THADAGroup(fGroup).DataCallBack.OnDataChange(fIDTrans,
