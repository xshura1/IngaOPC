procedure THABaseObj.AddChild(Obj: THABaseObj);
begin
 SetLength(fChilds,length(fChilds)+1);
 Obj.fParent:=self;
 fChilds[High(fChilds)]:=Obj;
end;

constructor THABaseObj.Create(Parent:THABaseObj; OID, ClassID: TOID; NameObj:string);
begin
 inherited Create;
 fOID:=OID;
 fParent:=Parent;
 fClassID:=ClassID;
 fNameObj:=NameObj;
 fChilds:=nil;
end;

destructor THABaseObj.destroy;
var i:integer;
begin
 {if fParent<>nil then
  for i:=0 to fParent.ChildCount-1 do
   if fParent.Childs[i]=self then
    begin
     fParent.fChilds[i]:=nil;
     break;
    end;
  }
