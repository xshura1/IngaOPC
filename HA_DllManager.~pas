 fListResult:=TList.Create;

 fDriverDataList:=TList.Create;
 fDriverDataList2:=TList.Create;


 fWork:=false;
 fConnected:=false;
 fNeedShowDialog:=false;
 // fResultWrite:=s_ok;
 fStop:=true;

end;

