 // fEvent.Free;
  ClearListResult;
  fListResult.Free;
  ClearDriverDataList;
  fDriverDataList.Free;
  fDriverDataList2.Free;

  FreeLibrary(fLibHND);
//  DeleteCriticalSection(fCSR);
