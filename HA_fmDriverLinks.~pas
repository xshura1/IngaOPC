function TDrvPaint.TestSel(X, Y: integer): boolean;
begin
 fIsProcWSel:=false;
 fIsProcRSel:=false;
 result:=(fLeft<=X) and (Right>=X) and (fTop<=Y) and (Bottom>=Y);
 if not result then exit;
 fIsProcWSel:=(fTop<=Y) and (Y<=(fTop+20));
 fIsProcRSel:=(Bottom>=Y) and (Y>Bottom-20);
end;

